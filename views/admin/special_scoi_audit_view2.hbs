<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{#if audit.title}}{{audit.title}}{{else}}Special SCOI Audit Report | {{audit.subject.name}}{{/if}}</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ── TOKENS ────────────────────────────────────── */
    :root {
      --navy:        #0F1C2E;
      --navy-mid:    #1E3A5F;
      --navy-light:  #2A5080;
      --gold:        #B8943F;
      --gold-light:  #D4B05A;
      --gold-rule:   #C9A961;
      --cream:       #FAFAF7;
      --white:       #FFFFFF;
      --g50:         #F8F9FA;
      --g100:        #F1F3F5;
      --g200:        #E5E7EB;
      --g300:        #D1D5DB;
      --g500:        #6B7280;
      --g700:        #374151;
      --g900:        #111827;
      --serif:       'Crimson Pro', Georgia, 'Times New Roman', serif;
      --sans:        'Inter', system-ui, sans-serif;
      --page-max:    820px;
    }

    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    html { font-size:16px; }

    body {
      font-family:var(--serif);
      background:var(--cream);
      color:var(--g900);
      line-height:1.75;
      -webkit-font-smoothing:antialiased;
    }

    /* ── PAGE SHELL ────────────────────────────────── */
    .page {
      max-width:var(--page-max);
      margin:3rem auto 5rem;
      background:var(--white);
      box-shadow: 0 2px 4px rgba(15,28,46,0.04),
                  0 8px 24px rgba(15,28,46,0.07),
                  0 32px 64px rgba(15,28,46,0.06);
      border-top:5px solid var(--navy);
    }

    /* ── COVER BAND ────────────────────────────────── */
    .cover {
      background:linear-gradient(160deg, var(--navy) 0%, var(--navy-mid) 100%);
      padding:3rem 4rem 2.5rem;
      position:relative;
      overflow:hidden;
      page-break-after: always;
      break-after: page;
    }
    .cover::before {
      position:absolute;
      right:-1.5rem;
      bottom:-1.5rem;
      font-family:var(--serif);
      font-size:11rem;
      font-weight:700;
      color:rgba(255,255,255,0.04);
      line-height:1;
      pointer-events:none;
      user-select:none;
    }
    .cover-eyebrow {
      font-family:var(--sans);
      font-size:0.68rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:3px;
      color:rgba(255,255,255,0.5);
      margin-bottom:1.25rem;
      display:flex;
      align-items:center;
      gap:0.75rem;
    }
    .cover-eyebrow::before {
      content:'';
      display:inline-block;
      width:2rem;
      height:1.5px;
      background:var(--gold-rule);
      flex-shrink:0;
    }
    .cover-title {
      font-family:var(--serif);
      font-size:2.6rem;
      font-weight:700;
      color:var(--white);
      line-height:1.2;
      margin-bottom:0.5rem;
      letter-spacing:-0.3px;
    }
    .cover-subtitle {
      font-family:var(--sans);
      font-size:0.875rem;
      color:rgba(255,255,255,0.6);
      font-weight:500;
      letter-spacing:0.2px;
      margin-bottom:2rem;
    }

    /* Meta grid on cover */
    .cover-meta {
      display:grid;
      /* minmax(0,1fr) prevents any column from exceeding its equal share */
      grid-template-columns:repeat(4, minmax(0, 1fr));
      gap:1.5px;
      margin-top:1.75rem;
      background:rgba(255,255,255,0.08);
    }
    .cm-item {
      padding:0.875rem 1.25rem;
      background:rgba(15,28,46,0.4);
      /* prevent the cell itself from overflowing the grid track */
      min-width:0;
      overflow:hidden;
    }
    .cm-label {
      font-family:var(--sans);
      font-size:0.62rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:1.5px;
      color:rgba(255,255,255,0.45);
      margin-bottom:0.35rem;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .cm-value {
      font-family:var(--sans);
      font-size:0.8rem;
      font-weight:600;
      color:rgba(255,255,255,0.9);
      line-height:1.4;
      /* long underscore-slug values wrap cleanly */
      word-break:break-word;
      overflow-wrap:anywhere;
    }

    /* ── BODY CONTENT ──────────────────────────────── */
    .body {
      padding:3.5rem 4rem;
      counter-reset: section-counter;
    }

    /* Gold rule divider */
    .rule {
      border:none;
      border-top:1.5px solid var(--g200);
      margin:2.75rem 0;
    }
    .rule-gold {
      border-color:var(--gold-rule);
      opacity:0.35;
    }

    /* ── SECTIONS ──────────────────────────────────── */
    .section {
      margin-bottom:3rem;
    }
    .section:last-child { margin-bottom:0; }

    .section-head {
      display:flex;
      align-items:center;
      gap:1rem;
      margin-bottom:1.5rem;
    }

    .section-num {
      font-family:var(--sans);
      font-size:0.62rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:2px;
      color:var(--gold);
      flex-shrink:0;
      counter-increment: section-counter;
    }
    .section-num::before {
      content: counter(section-counter, decimal-leading-zero);
    }
    .section-num > * { display:none; }

    .section-title {
      font-family:var(--serif);
      font-size:1.35rem;
      font-weight:700;
      color:var(--navy);
      line-height:1.2;
      letter-spacing:-0.2px;
    }
    .section-title-line {
      flex:1;
      height:1px;
      background:var(--g200);
      flex-shrink:0;
    }

    /* Body text */
    p {
      font-family:var(--serif);
      font-size:1.025rem;
      color:var(--g700);
      line-height:1.8;
      margin-bottom:0.75rem;
    }
    p:last-child { margin-bottom:0; }

    /* Lists */
    ul, ol {
      padding-left:1.5rem;
      margin:0.75rem 0;
    }
    li {
      font-family:var(--serif);
      font-size:1rem;
      color:var(--g700);
      line-height:1.75;
      margin-bottom:0.4rem;
      word-break:break-word;
      overflow-wrap:anywhere;
    }
    li strong { color:var(--navy); font-weight:700; }

    /* Inline strong */
    strong { color:var(--navy); font-weight:700; }

    /* ── META TABLE (definitions, normalization) ───── */
    .kv-table {
      width:100%;
      border-collapse:collapse;
      font-family:var(--sans);
      font-size:0.83rem;
      margin:1rem 0;
    }
    .kv-table tr { border-bottom:1px solid var(--g100); }
    .kv-table tr:last-child { border-bottom:none; }
    .kv-table td { padding:0.6rem 0.75rem; vertical-align:top; }
    .kv-table td:first-child { font-weight:700; color:var(--navy); width:38%; white-space:nowrap; }
    .kv-table td:last-child  { color:var(--g700); }

    /* ── SCORE BLOCKS ──────────────────────────────── */
    .score-panel {
      border:1px solid var(--g200);
      border-left:4px solid var(--navy-mid);
      margin-bottom:1.75rem;
      background:var(--white);
    }
    .score-panel:last-child { margin-bottom:0; }
    .sp-head {
      padding:1rem 1.5rem 0.875rem;
      border-bottom:1px solid var(--g100);
      background:var(--g50);
      /* Stack label → value → range vertically so long values never overflow */
      display:flex;
      flex-direction:column;
      gap:0.35rem;
    }
    .sp-label {
      font-family:var(--sans);
      font-size:0.75rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:1px;
      color:var(--g500);
    }
    .sp-value {
      font-family:var(--serif);
      /* clamp: shrinks gracefully for long strings, caps at 2rem */
      font-size:clamp(1.1rem, 3vw, 2rem);
      font-weight:700;
      color:var(--navy);
      line-height:1.2;
      /* allow underscore-slug strings to break across lines */
      word-break:break-word;
      overflow-wrap:anywhere;
    }
    .sp-range {
      font-family:var(--sans);
      font-size:0.78rem;
      color:var(--g500);
      font-weight:600;
    }
    .sp-body {
      padding:1.25rem 1.5rem;
    }
    .sp-body p {
      font-size:0.95rem;
      margin-bottom:0.5rem;
    }
    .sp-body ul { margin:0.5rem 0 0; }
    .sp-body li { font-size:0.92rem; }

    /* Placement tag */
    .placement-tag {
      display:inline-block;
      padding:0.2rem 0.75rem;
      background:rgba(15,28,46,0.08);
      color:var(--navy);
      font-family:var(--sans);
      font-size:0.72rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:1px;
      border-radius:2px;
      margin-top:0.5rem;
      /* long placement slugs wrap instead of overflow */
      word-break:break-word;
      overflow-wrap:anywhere;
      max-width:100%;
    }

    /* ── CALCULATIONS ──────────────────────────────── */
    .calc-block {
      background:var(--g50);
      border:1px solid var(--g200);
      padding:1.5rem;
      margin-bottom:1.25rem;
    }
    .calc-block:last-child { margin-bottom:0; }
    .calc-head {
      font-family:var(--sans);
      font-size:0.75rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:1px;
      color:var(--navy-light);
      margin-bottom:0.75rem;
    }
    .calc-formula {
      font-family:'Courier New', Courier, monospace;
      font-size:0.9rem;
      font-weight:700;
      color:var(--navy);
      background:rgba(15,28,46,0.05);
      padding:0.6rem 0.9rem;
      border-left:3px solid var(--gold-rule);
      margin-bottom:0.75rem;
      line-height:1.5;
    }
    .calc-result {
      font-family:var(--sans);
      font-size:1.1rem;
      font-weight:800;
      color:var(--navy);
      margin:0.5rem 0;
    }
    .calc-interp {
      font-family:var(--serif);
      font-size:0.95rem;
      font-style:italic;
      color:var(--g500);
      border-top:1px solid var(--g200);
      padding-top:0.75rem;
      margin-top:0.75rem;
      line-height:1.65;
    }

    /* ── FINDINGS ──────────────────────────────────── */
    .finding-core {
      background:var(--navy);
      color:var(--white);
      padding:2rem 2.25rem;
      margin-bottom:1.5rem;
    }
    .finding-core p {
      font-family:var(--serif);
      color:rgba(255,255,255,0.9);
      font-size:1.1rem;
      line-height:1.75;
      margin:0;
    }
    .classification-block {
      border:1px solid var(--g200);
      padding:1.25rem 1.5rem;
      background:var(--g50);
      margin-top:1.5rem;
    }
    .class-label {
      font-family:var(--sans);
      font-size:0.8rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:1px;
      color:var(--navy);
      margin-bottom:0.5rem;
    }
    .class-def {
      font-family:var(--serif);
      font-size:0.975rem;
      color:var(--g700);
      line-height:1.7;
      font-style:italic;
    }

    /* ── RISK SIGNALS ──────────────────────────────── */
    .risk-item {
      display:flex;
      gap:1rem;
      padding:1rem 0;
      border-bottom:1px solid var(--g100);
      align-items:flex-start;
    }
    .risk-item:last-child { border-bottom:none; }
    .risk-bullet {
      width:8px;
      height:8px;
      border-radius:50%;
      background:var(--gold-rule);
      flex-shrink:0;
      margin-top:0.55rem;
    }
    .risk-label {
      font-family:var(--sans);
      font-size:0.8rem;
      font-weight:700;
      color:var(--navy);
      margin-bottom:0.25rem;
      text-transform:uppercase;
      letter-spacing:0.5px;
    }
    .risk-desc {
      font-family:var(--serif);
      font-size:0.975rem;
      color:var(--g700);
      line-height:1.65;
    }

    /* ── COUNTERFACTUAL ────────────────────────────── */
    .counter-box {
      border:1px solid rgba(15,28,46,0.18);
      border-left:5px solid var(--navy);
      padding:2rem 2.25rem;
      background:var(--g50);
    }
    .counter-goal {
      font-family:var(--sans);
      font-size:0.8rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:1px;
      color:var(--navy-light);
      margin-bottom:0.35rem;
    }
    .counter-goal-val {
      font-family:var(--serif);
      font-size:1.1rem;
      font-weight:700;
      color:var(--navy);
      margin-bottom:1.25rem;
    }
    .counter-note {
      font-family:var(--serif);
      font-style:italic;
      color:var(--g500);
      font-size:0.95rem;
      border-top:1px solid var(--g200);
      padding-top:1rem;
      margin-top:1rem;
      line-height:1.7;
    }

    /* ── TAGS ──────────────────────────────────────── */
    .tag-row {
      display:flex;
      flex-wrap:wrap;
      gap:0.5rem;
      margin-top:0.5rem;
    }
    .tag {
      font-family:var(--sans);
      font-size:0.72rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:0.8px;
      padding:0.28rem 0.8rem;
      border:1px solid var(--g300);
      color:var(--g500);
      word-break:break-word;
      overflow-wrap:anywhere;
    }

    /* ── DISCLAIMERS ───────────────────────────────── */
    .disclaimer-item {
      font-family:var(--serif);
      font-size:0.9rem;
      color:var(--g500);
      line-height:1.7;
      padding:0.6rem 0;
      border-bottom:1px solid var(--g100);
    }
    .disclaimer-item:last-child { border-bottom:none; }
    .disclaimer-key {
      font-family:var(--sans);
      font-size:0.7rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:1px;
      color:var(--navy);
      margin-right:0.4rem;
    }

    /* ── SUBJECT INTELLIGENCE TABLE ───────────────── */
    .kv-table td:first-child {
      font-weight:700;
      color:var(--navy);
      width:35%;
      white-space:nowrap;
    }

    /* ── TEMPORAL LAYERS ──────────────────────────── */
    .temporal-grid {
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));
      gap:1px;
      background:var(--g200);
      border:1px solid var(--g200);
      margin-top:0.5rem;
    }
    .tl-cell {
      background:var(--white);
      padding:1.25rem 1.5rem;
    }
    .tl-period {
      font-family:var(--sans);
      font-size:0.68rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:1.5px;
      color:var(--gold);
      margin-bottom:0.3rem;
    }
    .tl-phase {
      font-family:var(--sans);
      font-size:0.72rem;
      font-weight:600;
      color:var(--navy-light);
      margin-bottom:0.5rem;
      word-break:break-word;
    }
    .tl-range {
      font-family:var(--serif);
      font-size:1.35rem;
      font-weight:700;
      color:var(--navy);
      line-height:1;
      margin-bottom:0.4rem;
    }
    .tl-interp {
      font-family:var(--serif);
      font-size:0.88rem;
      color:var(--g500);
      line-height:1.6;
      font-style:italic;
    }

    /* ── MAJOR TRANSITIONS ─────────────────────────── */
    .transition-list {
      border:1px solid var(--g200);
    }
    .transition-item {
      display:flex;
      gap:1.25rem;
      padding:1rem 1.5rem;
      border-bottom:1px solid var(--g100);
      align-items:flex-start;
    }
    .transition-item:last-child { border-bottom:none; }
    .transition-num {
      font-family:var(--sans);
      font-size:0.65rem;
      font-weight:800;
      color:var(--white);
      background:var(--navy-mid);
      min-width:1.5rem;
      height:1.5rem;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      margin-top:0.15rem;
    }
    .transition-label {
      font-family:var(--sans);
      font-size:0.78rem;
      font-weight:700;
      color:var(--navy);
      text-transform:uppercase;
      letter-spacing:0.5px;
      margin-bottom:0.25rem;
    }
    .transition-meaning {
      font-family:var(--serif);
      font-size:0.95rem;
      color:var(--g700);
      line-height:1.65;
    }

    /* ── STRUCTURAL LESSON ─────────────────────────── */
    .lesson-box {
      background:var(--g50);
      border:1px solid var(--g200);
      border-left:4px solid var(--gold-rule);
      padding:1.5rem 1.75rem;
      margin-top:1.25rem;
    }
    .lesson-box ul { margin:0; padding-left:1.25rem; }
    .lesson-box li {
      font-size:0.95rem;
      color:var(--g700);
      line-height:1.7;
      margin-bottom:0.35rem;
    }

    /* ── FOOTER ────────────────────────────────────── */
    .doc-footer {
      background:var(--navy);
      padding:2rem 4rem;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:1.5rem;
      flex-wrap:wrap;
    }
    .df-brand {
      font-family:var(--serif);
      font-size:1.3rem;
      font-weight:700;
      color:var(--gold-light);
      letter-spacing:-0.2px;
    }
    .df-meta {
      font-family:var(--sans);
      font-size:0.72rem;
      color:rgba(255,255,255,0.45);
      text-align:right;
      line-height:1.6;
    }
    .df-rule {
      width:100%;
      border:none;
      border-top:1px solid rgba(255,255,255,0.08);
      margin:0.5rem 0;
    }

    /* ── PRINT ─────────────────────────────────────── */
    @media print {
      body { background:white; }
      .page {
        max-width:100%;
        margin:0;
        box-shadow:none;
        border-top:none;
      }
      .cover { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
      .finding-core { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
      .doc-footer { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
      .cover-meta { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
      .section { page-break-inside:avoid; }
      .score-panel { page-break-inside:avoid; }
      .calc-block  { page-break-inside:avoid; }
      .counter-box { page-break-inside:avoid; }
    }

    /* ── RESPONSIVE ────────────────────────────────── */
    @media (max-width:860px) {
      .cover { padding:2.5rem 2rem 2rem; }
      .cover-title { font-size:2rem; }
      .cover-meta { grid-template-columns:repeat(2,1fr); }
      .body { padding:2.5rem 2rem; }
      .doc-footer { padding:1.75rem 2rem; flex-direction:column; align-items:flex-start; }
      .df-meta { text-align:left; }
    }
    @media (max-width:540px) {
      .cover { padding:2rem 1.25rem 1.75rem; }
      .cover-title { font-size:1.65rem; }
      .cover-meta { grid-template-columns:1fr 1fr; }
      .body { padding:2rem 1.25rem; }
      .sp-value { font-size:1rem; }
      .doc-footer { padding:1.5rem 1.25rem; }
      .page { margin:0; }
      .finding-core { padding:1.5rem 1.25rem; }
    }

    /* ══ EXTENDED SECTIONS (financial statement, ratios, time audit…) ══ */
    .exec-box { border:1px solid var(--g200); border-left:4px solid var(--gold); background:var(--g50); padding:1.5rem 1.75rem; }
    .exec-headline { font-family:var(--serif); font-size:1.2rem; font-weight:700; color:var(--navy); line-height:1.5; margin-bottom:1rem; }
    .chip-row { display:flex; flex-wrap:wrap; gap:0.5rem; margin:0.75rem 0; }
    .chip { font-family:var(--sans); font-size:0.72rem; font-weight:700; padding:0.3rem 0.7rem; border-radius:2px; background:var(--g100); color:var(--g700); letter-spacing:0.3px; word-break:break-word; }
    .chip-no { background:rgba(15,28,46,0.06); color:var(--navy); border:1px solid var(--g200); }
    .chip-no::before { content:'✕ '; color:#9B2C2C; }
    .call-banner { background:var(--navy); color:var(--white); font-family:var(--sans); font-weight:800; letter-spacing:4px; text-transform:uppercase; text-align:center; padding:1rem; font-size:1rem; margin-top:1rem; }
    .call-banner span { color:var(--gold-light); }
    .fs-table { width:100%; border-collapse:collapse; font-family:var(--sans); font-size:0.8rem; margin:0.75rem 0 1rem; }
    .fs-table th { text-align:left; font-size:0.66rem; text-transform:uppercase; letter-spacing:1px; color:var(--g500); border-bottom:2px solid var(--navy); padding:0.5rem 0.6rem; }
    .fs-table td { padding:0.5rem 0.6rem; border-bottom:1px solid var(--g100); vertical-align:top; color:var(--g700); }
    .fs-table td.num { text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums; }
    .fs-subtotal td { font-weight:700; color:var(--navy); background:var(--g50); border-top:1px solid var(--g300); }
    .fs-total td { font-weight:800; color:var(--white); background:var(--navy); }
    .basis { display:inline-block; font-size:0.58rem; font-weight:800; letter-spacing:0.6px; padding:0.1rem 0.4rem; border-radius:2px; white-space:nowrap; }
    .basis-REPORTED { background:#E6F0E9; color:#1F5130; }
    .basis-DERIVED { background:#FBF1DE; color:#7A5410; }
    .basis-PUBLIC-ROUNDED { background:#E8EEF7; color:#1E3A5F; }
    .fs-total .basis { background:rgba(255,255,255,0.15); color:var(--white); }
    .table-wrap { overflow-x:auto; }
    .note-box { font-family:var(--serif); font-size:0.95rem; color:var(--g700); background:var(--g50); border:1px solid var(--g200); padding:1rem 1.25rem; margin-top:1rem; line-height:1.7; }
    .bar-row { margin:0.65rem 0; }
    .bar-meta { display:flex; justify-content:space-between; gap:1rem; font-family:var(--sans); font-size:0.78rem; color:var(--g700); margin-bottom:0.25rem; }
    .bar-meta strong { white-space:nowrap; }
    .bar-track { height:12px; background:var(--g100); border-radius:2px; overflow:hidden; }
    .bar-fill { height:100%; background:linear-gradient(90deg, var(--navy-mid), var(--accent, var(--navy-light))); }
    .ratio-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:1px; background:var(--g200); border:1px solid var(--g200); margin-top:0.75rem; }
    .ratio-cell { background:var(--white); padding:0.9rem 1rem; break-inside:avoid; }
    .ratio-label { font-family:var(--sans); font-size:0.66rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--g500); }
    .ratio-value { font-family:var(--serif); font-size:1.5rem; font-weight:700; color:var(--navy); line-height:1.2; margin:0.15rem 0; }
    .ratio-formula { font-family:'Courier New', monospace; font-size:0.75rem; color:var(--g700); }
    .ratio-note { font-family:var(--sans); font-size:0.72rem; color:var(--g500); margin-top:0.2rem; }
    .two-col { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:1.25rem; }
    .mini-head { font-family:var(--sans); font-size:0.7rem; font-weight:800; text-transform:uppercase; letter-spacing:1px; color:var(--navy-light); margin:1rem 0 0.4rem; }
    .q-item { border-left:3px solid var(--gold-rule); padding:0.6rem 1rem; margin-bottom:0.75rem; background:var(--g50); break-inside:avoid; }
    .q-label { font-family:var(--sans); font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:1px; color:var(--gold); }
    .series-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:0.75rem; }
    .series-card { border:1px solid var(--g200); padding:1rem; background:var(--white); break-inside:avoid; }
    .series-card.current { border:2px solid var(--navy); background:var(--g50); }
    .series-year { font-family:var(--serif); font-size:1.6rem; font-weight:700; color:var(--navy); line-height:1; }
    .series-ncp { font-family:var(--sans); font-size:0.75rem; font-weight:700; color:var(--gold); margin:0.35rem 0; }
    .series-focus { font-family:var(--sans); font-size:0.75rem; color:var(--g700); line-height:1.5; }
    .formula-box { font-family:'Courier New', monospace; font-weight:700; color:var(--navy); background:rgba(15,28,46,0.05); border-left:3px solid var(--gold-rule); padding:0.8rem 1rem; margin:1rem 0; line-height:1.6; word-break:break-word; }
    .source-item { font-family:var(--sans); font-size:0.82rem; color:var(--g700); padding:0.55rem 0; border-bottom:1px solid var(--g100); }
    .source-item strong { display:block; }
    .cover-badge { display:inline-block; font-family:var(--sans); font-size:0.64rem; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:var(--navy); background:var(--accent, var(--gold-light)); padding:0.3rem 0.8rem; margin-bottom:1rem; }
    .cover-code { font-family:'Courier New', monospace; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.5rem; letter-spacing:1px; }
    .cover-title.long { font-size:1.75rem; line-height:1.3; }
    .cover-subtitle.long { font-size:0.85rem; line-height:1.6; max-width:95%; }
    .cover::before { content: attr(data-watermark); }

    /* ── Theme: Time Audit (distinct identity for the time-audit series) ── */
    .page.theme-time-audit { --accent:#6CABDD; border-top-color:#6CABDD; }
    .theme-time-audit .cover { background:linear-gradient(155deg, #071629 0%, #12355E 55%, #1C4E80 100%); border-bottom:4px solid #6CABDD; }
    .theme-time-audit .cover-eyebrow::before { background:#6CABDD; }
    .theme-time-audit .section-num { color:#2E78B8; }
    .theme-time-audit .finding-core { background:linear-gradient(135deg, #0B1F3A, #12355E); border-left:5px solid #6CABDD; }

    @media (max-width:640px) {
      .ratio-grid, .two-col { grid-template-columns:1fr; }
      .series-grid { grid-template-columns:1fr 1fr; }
      .cover-title.long { font-size:1.35rem; }
    }
    @media print {
      .fs-table tr, .ratio-cell, .series-card, .q-item, .exec-box, .note-box { page-break-inside:avoid; break-inside:avoid; }
      .fs-total td, .call-banner, .bar-fill, .cover-badge { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    }
  </style>
</head>
<body>

<article class="page{{#if audit.presentation.theme}} theme-{{audit.presentation.theme}}{{/if}}">

  <!-- ══ COVER BAND ══════════════════════════════════════════ -->
  <header class="cover" data-watermark="{{#if audit.presentation.watermark}}{{audit.presentation.watermark}}{{else}}SCOI{{/if}}">
    <div class="cover-eyebrow">CRIPFCnt Framework · {{#if audit.presentation.edition}}{{audit.presentation.edition}}{{else}}Special SCOI Audit{{/if}}</div>
    {{#if audit.presentation.badge}}<div class="cover-badge">{{audit.presentation.badge}}</div>{{/if}}
    {{#if audit.reportCode}}<div class="cover-code">{{audit.reportCode}}</div>{{/if}}
    {{#if audit.title}}
      <div class="cover-title long">{{audit.title}}</div>
      <div class="cover-subtitle long">{{#if audit.subtitle}}{{audit.subtitle}}{{else}}Special Structural Intelligence Assessment{{/if}}</div>
    {{else}}
      <div class="cover-title">Special SCOI<br>Audit Report</div>
      <div class="cover-subtitle">Special Structural Intelligence Assessment</div>
    {{/if}}

    <div class="cover-meta">
      <div class="cm-item">
        <div class="cm-label">Subject</div>
        <div class="cm-value">{{audit.subject.name}}</div>
      </div>
      <div class="cm-item">
        <div class="cm-label">Audit Type</div>
        <div class="cm-value">{{audit.auditType}}</div>
      </div>
      <div class="cm-item">
        <div class="cm-label">Framework</div>
        <div class="cm-value">
          {{audit.framework}}
          {{#if audit.matrix}}<span style="opacity:0.6;font-size:0.72rem;"> · {{audit.matrix}} matrix</span>{{/if}}
        </div>
      </div>
      <div class="cm-item">
        <div class="cm-label">Assessment Window</div>
        <div class="cm-value">
          {{#if audit.assessmentWindow.label}}
            {{audit.assessmentWindow.label}}
            {{#if audit.assessmentWindow.durationYears}}
              <span style="opacity:0.65;font-size:0.72rem;display:block;">({{audit.assessmentWindow.durationYears}} years)</span>
            {{/if}}
          {{else if audit.assessmentDate.label}}
            {{audit.assessmentDate.label}}
            {{#if audit.assessmentDate.type}}
              <span style="opacity:0.65;font-size:0.72rem;display:block;">{{audit.assessmentDate.type}}</span>
            {{/if}}
          {{else}}N/A{{/if}}
        </div>
      </div>
      <div class="cm-item">
        <div class="cm-label">Status</div>
        <div class="cm-value">{{audit.status}}</div>
      </div>
      <div class="cm-item">
        <div class="cm-label">Jurisdiction</div>
        <div class="cm-value">{{#if audit.subject.jurisdiction}}{{audit.subject.jurisdiction}}{{else}}-{{/if}}</div>
      </div>
      <div class="cm-item">
        <div class="cm-label">Author</div>
        <div class="cm-value">{{audit.author}}</div>
      </div>
      <div class="cm-item">
        <div class="cm-label">Entity Type</div>
        <div class="cm-value">{{audit.subject.entityType}}</div>
      </div>
      {{#if audit.presentation.classification}}
      <div class="cm-item" style="grid-column:1 / -1;">
        <div class="cm-label">Classification</div>
        <div class="cm-value">{{audit.presentation.classification}}</div>
      </div>
      {{/if}}
    </div>
  </header>

  <!-- ══ BODY ════════════════════════════════════════════════ -->
  <div class="body">

    <!-- Section 01 - Purpose (always present) -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Purpose of Audit</h2>
        <span class="section-title-line"></span>
      </div>
      <p>{{audit.purpose}}</p>
    </div>

    {{!-- ── Executive Summary ── --}}
    {{#if audit.executiveSummary}}
    <hr class="rule rule-gold">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Executive Summary</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="exec-box">
        {{#if audit.executiveSummary.headline}}<div class="exec-headline">{{audit.executiveSummary.headline}}</div>{{/if}}
        {{#if audit.executiveSummary.points}}
        <ul>
          {{#each audit.executiveSummary.points}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- ── Overriding Position ── --}}
    {{#if audit.overridingPosition}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Overriding Position</h2>
        <span class="section-title-line"></span>
      </div>
      {{#if audit.overridingPosition.principle}}<p>{{audit.overridingPosition.principle}}</p>{{/if}}
      {{#if audit.overridingPosition.recommendations}}
      <table class="kv-table">
        {{#each audit.overridingPosition.recommendations}}
        <tr><td>{{this.label}}</td><td>{{#if this.value}}Yes{{else}}No - not made by this audit{{/if}}</td></tr>
        {{/each}}
      </table>
      {{/if}}
      {{#if audit.overridingPosition.finalCall}}
        <div class="call-banner">Final Call · <span>{{audit.overridingPosition.finalCall}}</span></div>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── Methodological Departure ── --}}
    {{#if audit.methodologicalDeparture}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Methodological Departure</h2>
        <span class="section-title-line"></span>
      </div>
      {{#if audit.methodologicalDeparture.status}}<div class="placement-tag" style="margin:0 0 1rem;">{{audit.methodologicalDeparture.status}}</div>{{/if}}
      {{#if audit.methodologicalDeparture.reason}}<p>{{audit.methodologicalDeparture.reason}}</p>{{/if}}
      {{#with audit.methodologicalDeparture.newProvisionalMeasure}}
      <div class="calc-block" style="margin-top:1rem;">
        <div class="calc-head">New Provisional Measure · {{this.name}}{{#if this.shortName}} ({{this.shortName}}){{/if}}</div>
        {{#if this.formula}}<div class="calc-formula">{{this.formula}}</div>{{/if}}
        {{#if this.purpose}}<p style="font-size:0.95rem;">{{this.purpose}}</p>{{/if}}
      </div>
      {{/with}}
      {{#if audit.methodologicalDeparture.distinctFromStandardSCOI}}
        <div class="mini-head">How it differs from standard SCOI</div>
        <p>{{audit.methodologicalDeparture.distinctFromStandardSCOI}}</p>
      {{/if}}
      {{#if audit.methodologicalDeparture.methodologicalWarning}}
        <div class="note-box"><strong>Methodological warning.</strong> {{audit.methodologicalDeparture.methodologicalWarning}}</div>
      {{/if}}
      {{#if audit.methodologicalDeparture.experimentalStatus}}
        <div class="note-box"><strong>Experimental status.</strong> {{audit.methodologicalDeparture.experimentalStatus}}</div>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── Subject Intelligence (always rendered when any sub-field present) ── --}}
    {{#if audit.subject.entityScope}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Subject Intelligence Profile</h2>
        <span class="section-title-line"></span>
      </div>
      <table class="kv-table">
        {{#if audit.subject.entityScope}}
        <tr>
          <td>Entity Scope</td>
          <td>{{audit.subject.entityScope}}</td>
        </tr>
        {{/if}}
        {{#if audit.subject.sectorContext}}
        <tr>
          <td>Sector Context</td>
          <td>{{audit.subject.sectorContext}}</td>
        </tr>
        {{/if}}
        {{#if audit.subject.jurisdiction}}
        <tr>
          <td>Jurisdiction</td>
          <td>{{audit.subject.jurisdiction}}</td>
        </tr>
        {{/if}}
        {{#if audit.assessmentWindow.type}}
        <tr>
          <td>Phase Classification</td>
          <td>{{audit.assessmentWindow.type}}</td>
        </tr>
        {{/if}}
        {{#if audit.assessmentDate.type}}
        <tr>
          <td>Assessment Type</td>
          <td>{{audit.assessmentDate.type}}</td>
        </tr>
        {{/if}}
        {{#if audit.matrix}}
        <tr>
          <td>Analytical Matrix</td>
          <td>{{audit.matrix}}</td>
        </tr>
        {{/if}}
        {{#if audit.revisionPolicy}}
        <tr>
          <td>Revision Policy</td>
          <td>{{audit.revisionPolicy}}</td>
        </tr>
        {{/if}}
      </table>
    </div>
    {{/if}}

    {{#if audit.definitions}}
    <hr class="rule">
    <!-- Section N - Definitions -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Definitions</h2>
        <span class="section-title-line"></span>
      </div>
      <table class="kv-table">
        {{#each audit.definitions}}
          <tr>
            <td>{{@key}}</td>
            <td>{{this}}</td>
          </tr>
        {{/each}}
      </table>
    </div>
    {{/if}}

    {{#if audit.method}}
    <hr class="rule">
    <!-- Section N - Method -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Method</h2>
        <span class="section-title-line"></span>
      </div>

      {{#if audit.method.modelType}}
        <p><strong>Model Type:</strong> {{audit.method.modelType}}</p>
      {{/if}}

      {{#if audit.method.notes}}
        <ul>
          {{#each audit.method.notes}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if audit.method.normalization}}
        <table class="kv-table" style="margin-top:1rem;">
          {{#each audit.method.normalization}}
            <tr>
              <td>{{@key}}</td>
              <td>{{this}}</td>
            </tr>
          {{/each}}
        </table>
      {{/if}}
    </div>
    {{/if}}

    {{#if audit.context}}
    <hr class="rule">
    <!-- Section N - Context -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Context</h2>
        <span class="section-title-line"></span>
      </div>

      {{#if audit.context.trigger}}
        <p>{{audit.context.trigger}}</p>
      {{/if}}

      {{#if audit.context.civilizationFrame}}
        <ul>
          {{#each audit.context.civilizationFrame}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if audit.context.conditions}}
        <p style="margin-top:1rem;"><strong>Conditions:</strong></p>
        <ul>
          {{#each audit.context.conditions}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{!-- coreDoctrine stored under context.doctrine by the importer --}}
      {{#if audit.context.doctrine}}
        {{#if audit.context.doctrine.primaryEquilibrium}}
          <p style="margin-top:1.25rem;">
            <strong>{{audit.context.doctrine.primaryEquilibrium.label}}:</strong>
            {{audit.context.doctrine.primaryEquilibrium.definition}}
          </p>
        {{/if}}
        {{#if audit.context.doctrine.CRIPFCntPosition.summary}}
          <p style="margin-top:0.75rem;font-style:italic;color:var(--g500);">
            {{audit.context.doctrine.CRIPFCntPosition.summary}}
          </p>
        {{/if}}
        {{#if audit.context.doctrine.secondaryEquilibriums}}
          <p style="margin-top:0.75rem;"><strong>Secondary Equilibriums:</strong></p>
          <ul>
            {{#each audit.context.doctrine.secondaryEquilibriums}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      {{/if}}

      {{!-- fallback: coreDoctrine stored at top level (new schema field) --}}
      {{#unless audit.context.doctrine}}
        {{#if audit.coreDoctrine.primaryEquilibrium}}
          <p style="margin-top:1.25rem;">
            <strong>{{audit.coreDoctrine.primaryEquilibrium.label}}:</strong>
            {{audit.coreDoctrine.primaryEquilibrium.definition}}
          </p>
        {{/if}}
        {{#if audit.coreDoctrine.CRIPFCntPosition.summary}}
          <p style="margin-top:0.75rem;font-style:italic;color:var(--g500);">
            {{audit.coreDoctrine.CRIPFCntPosition.summary}}
          </p>
        {{/if}}
        {{#if audit.coreDoctrine.secondaryEquilibriums}}
          <p style="margin-top:0.75rem;"><strong>Secondary Equilibriums:</strong></p>
          <ul>
            {{#each audit.coreDoctrine.secondaryEquilibriums}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      {{/unless}}

    </div>
    {{/if}}

    {{!-- ── Historical Context (GS-style audits) ──────────────────────────── --}}
    {{#if audit.historicalContext}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Historical Context</h2>
        <span class="section-title-line"></span>
      </div>
      {{#if audit.historicalContext.summary}}
        <p>{{audit.historicalContext.summary}}</p>
      {{/if}}
      {{#if audit.historicalContext.conditions}}
        <p style="margin-top:1rem;"><strong>Prevailing Conditions:</strong></p>
        <ul>
          {{#each audit.historicalContext.conditions}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── Temporal Layers (Lawyer cumulative audits) ─────────────────────── --}}
    {{#if audit.temporalLayers}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Temporal SCOI Layers</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="temporal-grid">
        {{#each audit.temporalLayers}}
        <div class="tl-cell">
          <div class="tl-period">{{@key}}</div>
          <div class="tl-phase">{{this.phase}}</div>
          <div class="tl-range">{{this.SCOIRange.[0]}} – {{this.SCOIRange.[1]}}</div>
          <div class="tl-interp">{{this.interpretation}}</div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- ── Major Structural Transitions (Lawyer cumulative audits) ───────── --}}
    {{#if audit.majorStructuralTransitions}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Major Structural Transitions</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="transition-list">
        {{#each audit.majorStructuralTransitions}}
        <div class="transition-item">
          <div class="transition-num">{{@key}}</div>
          <div>
            <div class="transition-label">{{this.label}}</div>
            <div class="transition-meaning">{{this.meaning}}</div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <hr class="rule rule-gold">
    <!-- Section N - SCOI Metrics (always present) -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">SCOI Metrics &amp; Actual Result</h2>
        <span class="section-title-line"></span>
      </div>

      {{!-- ───────────────────────────────────────────────────────────────────
           Score source priority:
             1. audit.scores                        (GS-style audits)
             2. audit.currentCumulativeAssessment   (Lawyer cumulative audits)
           ─────────────────────────────────────────────────────────────────── --}}

      {{#if audit.scores}}

        <!-- Visibility -->
        <div class="score-panel">
          <div class="sp-head">
            <div class="sp-label">Visibility / Systemic Exposure</div>
            <div class="sp-value">{{audit.scores.visibility_denominator.rating}}</div>
            <div class="sp-range">
              Normalised Range:
              {{audit.scores.visibility_denominator.normalizedRange.[0]}}
              –
              {{audit.scores.visibility_denominator.normalizedRange.[1]}}
            </div>
          </div>
          {{#if audit.scores.visibility_denominator.drivers}}
          <div class="sp-body">
            <p><strong>Drivers:</strong></p>
            <ul>
              {{#each audit.scores.visibility_denominator.drivers}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        </div>

        <!-- Responsibility -->
        <div class="score-panel">
          <div class="sp-head">
            <div class="sp-label">Responsibility / Contribution Alignment</div>
            <div class="sp-value">{{audit.scores.responsibility_numerator.rating}}</div>
            <div class="sp-range">
              Normalised Range:
              {{audit.scores.responsibility_numerator.normalizedRange.[0]}}
              –
              {{audit.scores.responsibility_numerator.normalizedRange.[1]}}
            </div>
          </div>
          {{#if audit.scores.responsibility_numerator.observedSignals}}
          <div class="sp-body">
            <p><strong>Observed Signals:</strong></p>
            <ul>
              {{#each audit.scores.responsibility_numerator.observedSignals}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        </div>

        <!-- Negative Externalities (GS 1974-2009 and similar) -->
        {{#if audit.scores.negative_externalities}}
        <div class="score-panel" style="border-left-color:#B45309;">
          <div class="sp-head">
            <div class="sp-label" style="color:#B45309;">Negative Externalities / Risk Signals</div>
            <div class="sp-range">
              Normalised Range:
              {{audit.scores.negative_externalities.normalizedRange.[0]}}
              –
              {{audit.scores.negative_externalities.normalizedRange.[1]}}
            </div>
          </div>
          {{#if audit.scores.negative_externalities.observedSignals}}
          <div class="sp-body">
            <p><strong>Observed Signals:</strong></p>
            <ul>
              {{#each audit.scores.negative_externalities.observedSignals}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        </div>
        {{/if}}

        <!-- Framework Result -->
        {{#if audit.scores.SCOI_framework_result}}
        <div class="score-panel" style="border-left-color:var(--gold-rule);">
          <div class="sp-head">
            <div class="sp-label">SCOI Framework Result</div>
            <div class="sp-value">
              {{audit.scores.SCOI_framework_result.rangeEstimate.[0]}}–{{audit.scores.SCOI_framework_result.rangeEstimate.[1]}}
            </div>
          </div>
          <div class="sp-body">
            <div class="placement-tag">{{audit.scores.SCOI_framework_result.placement}}</div>
            <p style="margin-top:1rem;font-style:italic;color:var(--g500);">{{audit.scores.SCOI_framework_result.interpretation}}</p>
          </div>
        </div>
        {{/if}}

        <!-- Event Result -->
        {{#if audit.scores.SCOI_event_result}}
        <div class="score-panel" style="border-left-color:var(--gold-rule);">
          <div class="sp-head">
            <div class="sp-label">SCOI Event Result</div>
            <div class="sp-value">
              {{audit.scores.SCOI_event_result.rangeEstimate.[0]}}–{{audit.scores.SCOI_event_result.rangeEstimate.[1]}}
            </div>
          </div>
          <div class="sp-body">
            <div class="placement-tag">{{audit.scores.SCOI_event_result.placement}}</div>
            <p style="margin-top:1rem;font-style:italic;color:var(--g500);">{{audit.scores.SCOI_event_result.interpretation}}</p>
          </div>
        </div>
        {{/if}}

      {{else if audit.currentCumulativeAssessment}}

        <!-- Visibility (cumulative format) -->
        <div class="score-panel">
          <div class="sp-head">
            <div class="sp-label">Visibility / Systemic Exposure</div>
            <div class="sp-value">{{audit.currentCumulativeAssessment.visibility_denominator.rating}}</div>
            <div class="sp-range">
              Normalised Range:
              {{audit.currentCumulativeAssessment.visibility_denominator.normalizedRange.[0]}}
              –
              {{audit.currentCumulativeAssessment.visibility_denominator.normalizedRange.[1]}}
            </div>
          </div>
          {{#if audit.currentCumulativeAssessment.visibility_denominator.drivers}}
          <div class="sp-body">
            <p><strong>Drivers:</strong></p>
            <ul>
              {{#each audit.currentCumulativeAssessment.visibility_denominator.drivers}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        </div>

        <!-- Responsibility (cumulative format) -->
        <div class="score-panel">
          <div class="sp-head">
            <div class="sp-label">Responsibility / Contribution Alignment</div>
            <div class="sp-value">{{audit.currentCumulativeAssessment.responsibility_numerator.rating}}</div>
            <div class="sp-range">
              Normalised Range:
              {{audit.currentCumulativeAssessment.responsibility_numerator.normalizedRange.[0]}}
              –
              {{audit.currentCumulativeAssessment.responsibility_numerator.normalizedRange.[1]}}
            </div>
          </div>
          {{#if audit.currentCumulativeAssessment.responsibility_numerator.observedSignals}}
          <div class="sp-body">
            <p><strong>Observed Signals:</strong></p>
            <ul>
              {{#each audit.currentCumulativeAssessment.responsibility_numerator.observedSignals}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        </div>

        <!-- Framework Result (cumulative format) -->
        {{#if audit.currentCumulativeAssessment.SCOI_framework_result}}
        <div class="score-panel" style="border-left-color:var(--gold-rule);">
          <div class="sp-head">
            <div class="sp-label">SCOI Framework Result</div>
            <div class="sp-value">
              {{audit.currentCumulativeAssessment.SCOI_framework_result.rangeEstimate.[0]}}–{{audit.currentCumulativeAssessment.SCOI_framework_result.rangeEstimate.[1]}}
            </div>
          </div>
          <div class="sp-body">
            <div class="placement-tag">{{audit.currentCumulativeAssessment.SCOI_framework_result.placement}}</div>
            <p style="margin-top:1rem;font-style:italic;color:var(--g500);">{{audit.currentCumulativeAssessment.SCOI_framework_result.interpretation}}</p>
          </div>
        </div>
        {{/if}}

      {{else if audit.provisionalSCOICalculations.necessaryContributionProfitSCOI}}
        {{#with audit.provisionalSCOICalculations.necessaryContributionProfitSCOI}}
        <div class="score-panel">
          <div class="sp-head">
            <div class="sp-label">Necessary Contribution to Profit SCOI (NC-P) · Provisional</div>
            <div class="sp-value">{{this.reportedSCOI}}</div>
            <div class="sp-range">Gross {{this.grossSCOI}} · {{this.calculation}}</div>
          </div>
          <div class="sp-body">
            {{#if this.interpretation}}<p>{{this.interpretation}}</p>{{/if}}
            {{#if this.status}}<div class="placement-tag">{{this.status}}</div>{{/if}}
          </div>
        </div>
        {{/with}}
        {{#with audit.provisionalSCOICalculations.voluntaryContributionProfitCapacitySCOI}}
        <div class="score-panel">
          <div class="sp-head">
            <div class="sp-label">Voluntary Contribution to Profit Capacity SCOI · Floor</div>
            <div class="sp-value">{{this.reportedMinimum}}</div>
            <div class="sp-range">Gross {{this.grossSCOI}} · {{this.calculation}}</div>
          </div>
          <div class="sp-body">
            {{#if this.interpretation}}<p>{{this.interpretation}}</p>{{/if}}
            {{#if this.status}}<div class="placement-tag">{{this.status}}</div>{{/if}}
          </div>
        </div>
        {{/with}}
      {{/if}}
    </div>

    {{!-- ── Financial Statement ── --}}
    {{#if audit.financialStatement}}
    <hr class="rule rule-gold">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">{{#if audit.financialStatement.title}}{{audit.financialStatement.title}}{{else}}Financial Statement{{/if}}</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="chip-row">
        <span class="basis basis-REPORTED">REPORTED</span>
        <span class="basis basis-DERIVED">DERIVED</span>
        <span class="basis basis-PUBLIC-ROUNDED">PUBLIC-ROUNDED</span>
      </div>
      <div class="table-wrap">
      <table class="fs-table">
        <thead><tr><th>Line</th><th style="text-align:right;">{{#if audit.financialStatement.currency}}{{audit.financialStatement.currency}}{{else}}Value{{/if}}</th><th style="text-align:right;">% Revenue</th><th>Source</th></tr></thead>
        <tbody>
        {{#each audit.financialStatement.lines}}
          <tr class="fs-{{this.rowType}}">
            <td>{{this.label}}</td>
            <td class="num">{{this.value}}</td>
            <td class="num">{{this.pctOfRevenue}}</td>
            <td><span class="basis basis-{{this.basis}}">{{this.basis}}</span></td>
          </tr>
        {{/each}}
        </tbody>
      </table>
      </div>
      {{#if audit.financialStatement.reconciliationNote}}
        <div class="note-box"><strong>Reconciliation.</strong> {{audit.financialStatement.reconciliationNote}}</div>
      {{/if}}
      {{#if audit.financialStatement.dataCorrections}}
        <div class="mini-head">Data corrections in this edition</div>
        <ul>{{#each audit.financialStatement.dataCorrections}}<li>{{this}}</li>{{/each}}</ul>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── Revenue mix + 75/25 visual ── --}}
    {{#if audit.revenueBreakdown}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">{{#if audit.revenueBreakdown.title}}{{audit.revenueBreakdown.title}}{{else}}Revenue Mix{{/if}}</h2>
        <span class="section-title-line"></span>
      </div>
      {{#each audit.revenueBreakdown.lines}}
        <div class="bar-row">
          <div class="bar-meta"><span>{{this.label}}</span><strong>{{this.valueDisplay}} · {{this.share}}</strong></div>
          <div class="bar-track"><div class="bar-fill" style="width:{{this.widthPct}}%;"></div></div>
        </div>
      {{/each}}
      {{#if audit.revenueBreakdown.note}}<p style="margin-top:0.75rem;font-size:0.95rem;">{{audit.revenueBreakdown.note}}</p>{{/if}}

      {{#if audit.ratioVisual}}
        <div class="mini-head" style="margin-top:1.75rem;">{{audit.ratioVisual.title}}</div>
        {{#each audit.ratioVisual.bars}}
          <div class="bar-row">
            <div class="bar-meta"><span>{{this.label}}</span><strong>{{this.valueDisplay}}</strong></div>
            <div class="bar-track"><div class="bar-fill" style="width:{{this.widthPct}}%;"></div></div>
          </div>
        {{/each}}
        {{#if audit.ratioVisual.caption}}<p style="margin-top:0.75rem;font-size:0.95rem;font-style:italic;color:var(--g500);">{{audit.ratioVisual.caption}}</p>{{/if}}
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── Key Ratios ── --}}
    {{#if audit.keyRatios}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Key Ratios</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="ratio-grid">
        {{#each audit.keyRatios}}
        <div class="ratio-cell">
          <div class="ratio-label">{{this.label}}</div>
          <div class="ratio-value">{{this.value}}</div>
          <div class="ratio-formula">{{this.formula}}</div>
          {{#if this.note}}<div class="ratio-note">{{this.note}}</div>{{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if audit.calculations}}
    <hr class="rule">
    <!-- Section N - Calculations -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Calculations</h2>
        <span class="section-title-line"></span>
      </div>
      {{#each audit.calculations}}
      <div class="calc-block">
        <div class="calc-head">{{@key}}</div>
        {{#if this.formula}}
          <div class="calc-formula">{{this.formula}}</div>
        {{/if}}
        {{#if this.working}}
          <p style="font-size:0.9rem;margin-bottom:0.5rem;">{{this.working}}</p>
        {{/if}}
        {{#if this.value}}
          <div class="calc-result">≈ {{this.value}}</div>
        {{/if}}
        {{#if this.meaning}}
          <p style="font-size:0.9rem;">{{this.meaning}}</p>
        {{/if}}
        {{#if this.interpretation}}
          <div class="calc-interp">{{this.interpretation}}</div>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- ── Sensitivity Analysis ── --}}
    {{#if audit.sensitivityAnalysis}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Sensitivity Analysis</h2>
        <span class="section-title-line"></span>
      </div>
      {{#if audit.sensitivityAnalysis.note}}<p>{{audit.sensitivityAnalysis.note}}</p>{{/if}}
      <div class="table-wrap">
      <table class="fs-table">
        <thead><tr><th>Basis</th><th>Calculation</th><th style="text-align:right;">Result</th><th>Reading</th></tr></thead>
        <tbody>
        {{#each audit.sensitivityAnalysis.rows}}
          <tr{{#if @first}} class="fs-subtotal"{{/if}}>
            <td>{{this.basis}}</td><td>{{this.calculation}}</td><td class="num">{{this.result}}</td><td>{{this.reading}}</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
      </div>
    </div>
    {{/if}}

    {{!-- ── Contribution composition (numerator / denominator) ── --}}
    {{#if audit.provisionalSCOICalculations}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Contribution Composition</h2>
        <span class="section-title-line"></span>
      </div>
      {{#with audit.provisionalSCOICalculations.necessaryContributionProfitSCOI}}
        <div class="two-col">
          <div class="calc-block">
            <div class="calc-head">Numerator · {{this.numerator.label}}</div>
            <div class="calc-result">{{this.numerator.valueDisplay}}</div>
            <div class="ratio-note">{{this.numerator.basis}}</div>
            <div class="mini-head">Included conceptually</div>
            <ul>{{#each this.numerator.includedConceptually}}<li>{{this}}</li>{{/each}}</ul>
            <div class="mini-head">Excluded</div>
            <ul>{{#each this.numerator.excluded}}<li>{{this}}</li>{{/each}}</ul>
          </div>
          <div class="calc-block">
            <div class="calc-head">Denominator · {{this.denominator.label}}</div>
            <div class="calc-result">{{this.denominator.valueDisplay}}</div>
            <div class="ratio-note">{{this.denominator.basis}}</div>
            {{#if this.civilizationMeaning}}
              <div class="mini-head">Civilization meaning</div>
              <p style="font-size:0.95rem;">{{this.civilizationMeaning}}</p>
            {{/if}}
          </div>
        </div>
        {{#if this.nonMeaning}}
          <div class="mini-head">What {{this.reportedSCOI}} does not mean</div>
          <div class="chip-row">{{#each this.nonMeaning}}<span class="chip chip-no">{{this}}</span>{{/each}}</div>
        {{/if}}
      {{/with}}
      {{#with audit.provisionalSCOICalculations.voluntaryContributionProfitCapacitySCOI}}
        {{#if this.qualification}}<div class="note-box"><strong>Voluntary contribution qualification.</strong> {{this.qualification}}</div>{{/if}}
      {{/with}}
    </div>
    {{/if}}

    {{!-- ── Structural Comparison ── --}}
    {{#if audit.SCOIStructuralComparison}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Necessary vs Voluntary: Structural Comparison</h2>
        <span class="section-title-line"></span>
      </div>
      <table class="kv-table">
        <tr><td>Necessary Contribution ÷ Profit</td><td>{{audit.SCOIStructuralComparison.necessaryContributionProfit}}</td></tr>
        <tr><td>Verified Voluntary ÷ Profit (floor)</td><td>{{audit.SCOIStructuralComparison.verifiedMinimumVoluntaryContributionProfit}}</td></tr>
      </table>
      {{#if audit.SCOIStructuralComparison.principle}}<p>{{audit.SCOIStructuralComparison.principle}}</p>{{/if}}
      {{#if audit.SCOIStructuralComparison.scaleNote}}<p>{{audit.SCOIStructuralComparison.scaleNote}}</p>{{/if}}
      <div class="chip-row">{{#each audit.SCOIStructuralComparison.distinctions}}<span class="chip">{{this}}</span>{{/each}}</div>
    </div>
    {{/if}}

    <hr class="rule rule-gold">
    <!-- Section N - Findings (always present) -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Findings</h2>
        <span class="section-title-line"></span>
      </div>

      {{!-- ───────────────────────────────────────────────────────────────────
           Core finding priority:
             1. audit.coreFinding          (Lawyer JSON: top-level key)
             2. findings.coreFinding       (nested key)
             3. findings.primaryFinding    (GS-style key)
             4. CRIPFCntInterpretation.summary (interpretation fallback)
           ─────────────────────────────────────────────────────────────────── --}}
      <div class="finding-core">
        {{#if audit.coreFinding}}
          <p>{{audit.coreFinding}}</p>
        {{else if audit.findings.coreFinding}}
          <p>{{audit.findings.coreFinding}}</p>
        {{else if audit.findings.primaryFinding}}
          <p>{{audit.findings.primaryFinding}}</p>
        {{else if audit.CRIPFCntInterpretation.summary}}
          <p>{{audit.CRIPFCntInterpretation.summary}}</p>
        {{else}}
          <p style="opacity:0.45;font-style:italic;">No core finding recorded.</p>
        {{/if}}
      </div>

      {{!-- Secondary findings --}}
      {{#if audit.findings.secondaryFindings}}
        <ul style="margin-top:1.25rem;">
          {{#each audit.findings.secondaryFindings}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{!-- Classification block --}}
      {{#if audit.findings.classification}}
        <div class="classification-block">
          <div class="class-label">{{audit.findings.classification.label}}</div>
          <div class="class-def">{{audit.findings.classification.definition}}</div>
        </div>
      {{else if audit.classification}}
        <div class="classification-block">
          <div class="class-label">{{audit.classification.label}}</div>
          <div class="class-def">{{audit.classification.definition}}</div>
        </div>
      {{/if}}
    </div>

    {{!-- ── Civilization Foundation ── --}}
    {{#if audit.civilizationFoundation}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Civilization Foundation</h2>
        <span class="section-title-line"></span>
      </div>
      {{#if audit.civilizationFoundation.principle}}<div class="placement-tag" style="margin:0 0 1rem;">{{audit.civilizationFoundation.principle}}</div>{{/if}}
      {{#if audit.civilizationFoundation.description}}<p>{{audit.civilizationFoundation.description}}</p>{{/if}}
      {{#if audit.civilizationFoundation.observedFoundation}}
