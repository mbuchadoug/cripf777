    {{!-- ── Regulatory (Association) Audit ── --}}
    {{#if audit.associationAudit}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Regulatory Association Audit</h2>
        <span class="section-title-line"></span>
      </div>
      {{#if audit.associationAudit.principle}}<div class="placement-tag" style="margin:0 0 1rem;">{{audit.associationAudit.principle}}</div>{{/if}}
      <ul>{{#each audit.associationAudit.questions}}<li>{{this}}</li>{{/each}}</ul>
      {{#if audit.associationAudit.nonFinding}}<div class="note-box"><strong>Non-finding.</strong> {{audit.associationAudit.nonFinding}}</div>{{/if}}
