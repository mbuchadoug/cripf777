    {{/if}}

    {{#if audit.civilizationRiskSignals}}
    <hr class="rule">
    <!-- Section N - Civilization Risk Signals -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Civilization Risk Signals</h2>
        <span class="section-title-line"></span>
      </div>
      {{#each audit.civilizationRiskSignals}}
      <div class="risk-item">
        <div class="risk-bullet"></div>
        <div>
          <div class="risk-label">{{this.riskLabel}}</div>
          <div class="risk-desc">{{this.description}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if audit.counterfactual}}
    <hr class="rule">
    <!-- Section N - Counterfactual -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Counterfactual Requirements</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="counter-box">
        <div class="counter-goal">Target</div>
        <div class="counter-goal-val">{{audit.counterfactual.goal}}</div>
        {{#if audit.counterfactual.question}}<p style="margin:0.75rem 0;">{{audit.counterfactual.question}}</p>{{/if}}
        {{#if audit.counterfactual.question}}<div class="counter-goal" style="margin-top:0.5rem;">Variables</div>{{/if}}
        <ul>
          {{#each audit.counterfactual.requirements}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
        {{#if audit.counterfactual.note}}
          <div class="counter-note">{{audit.counterfactual.note}}</div>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- ── Civilization Recommendations ── --}}
    {{#if audit.civilizationRecommendations}}
    <hr class="rule rule-gold">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Civilization Recommendations</h2>
        <span class="section-title-line"></span>
      </div>
      {{#if audit.civilizationRecommendations.orientation}}<div class="placement-tag" style="margin:0 0 1rem;">{{audit.civilizationRecommendations.orientation}}</div>{{/if}}
      {{#if audit.civilizationRecommendations.objective}}<p><strong>Objective.</strong> {{audit.civilizationRecommendations.objective}}</p>{{/if}}
      <ol>{{#each audit.civilizationRecommendations.recommendations}}<li>{{this}}</li>{{/each}}</ol>
      {{#if audit.civilizationRecommendations.civilizationFormula}}<div class="formula-box">{{audit.civilizationRecommendations.civilizationFormula}}</div>{{/if}}
      {{#if audit.civilizationRecommendations.finalQuestion}}<p style="font-style:italic;">{{audit.civilizationRecommendations.finalQuestion}}</p>{{/if}}
      {{#if audit.civilizationRecommendations.overridingRecommendation}}<div class="call-banner">Overriding Recommendation · <span>{{audit.civilizationRecommendations.overridingRecommendation}}</span></div>{{/if}}
    </div>
    {{/if}}

    {{!-- ── Time Audit Series ── --}}
    {{#if audit.futureTimeAuditSeries}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Time Audit Series</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="series-grid">
        {{#each audit.futureTimeAuditSeries.reports}}
        <div class="series-card{{#if @first}} current{{/if}}">
          <div class="ratio-label">{{this.code}} · {{this.status}}</div>
          <div class="series-year">{{this.reference}}</div>
          <div class="series-ncp">NC-P SCOI: {{this.ncp}}</div>
          <div class="series-focus">{{this.focus}}</div>
        </div>
        {{/each}}
      </div>
      {{#if audit.futureTimeAuditSeries.comparativeObjective}}<p style="margin-top:1rem;">{{audit.futureTimeAuditSeries.comparativeObjective}}</p>{{/if}}
    </div>
    {{/if}}

    {{!-- ── Final Civilization Call ── --}}
    {{#if audit.finalCivilizationCall}}
    <hr class="rule rule-gold">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Final Civilization Call</h2>
        <span class="section-title-line"></span>
      </div>
      <table class="kv-table">
        {{#if audit.finalCivilizationCall.startingPoint}}<tr><td>Starting point</td><td>{{audit.finalCivilizationCall.startingPoint}}</td></tr>{{/if}}
        {{#if audit.finalCivilizationCall.recognition}}<tr><td>Recognition</td><td>{{audit.finalCivilizationCall.recognition}}</td></tr>{{/if}}
      </table>
      {{#if audit.finalCivilizationCall.not}}
        <div class="mini-head">This audit is not</div>
        <div class="chip-row">{{#each audit.finalCivilizationCall.not}}<span class="chip chip-no">{{this}}</span>{{/each}}</div>
      {{/if}}
      {{#if audit.finalCivilizationCall.statement}}
        <div class="finding-core" style="margin-top:1rem;"><p>{{audit.finalCivilizationCall.statement}}</p></div>
      {{/if}}
      {{#if audit.finalCivilizationCall.call}}<div class="call-banner"><span>{{audit.finalCivilizationCall.call}}</span></div>{{/if}}
    </div>
    {{/if}}

    {{!-- ── Sources ── --}}
    {{#if audit.sources}}
    <hr class="rule">
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Sources &amp; Data Provenance</h2>
        <span class="section-title-line"></span>
      </div>
      {{#each audit.sources}}
        <div class="source-item"><strong>{{this.title}}</strong>{{this.publisher}}{{#if this.usedFor}} · <em>{{this.usedFor}}</em>{{/if}}</div>
      {{/each}}
    </div>
    {{/if}}

    {{#if audit.disclaimers}}
    <hr class="rule">
    <!-- Section N - Disclaimers -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Disclaimers</h2>
        <span class="section-title-line"></span>
      </div>
      {{#each audit.disclaimers}}
        {{#if this}}
          <div class="disclaimer-item">
            <span class="disclaimer-key">{{@key}}:</span>{{this}}
          </div>
        {{/if}}
      {{/each}}
    </div>
    {{/if}}

    {{#if audit.tags}}
    <hr class="rule">
    <!-- Section N - Tags -->
    <div class="section">
      <div class="section-head">
        <span class="section-num"></span>
        <h2 class="section-title">Tags</h2>
        <span class="section-title-line"></span>
      </div>
      <div class="tag-row">
        {{#each audit.tags}}
          <span class="tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

  </div><!-- /body -->

  <!-- ══ FOOTER ══════════════════════════════════════════════ -->
  <footer class="doc-footer">
    <div class="df-brand">CRIPFCnt</div>
    <hr class="df-rule">
    <div class="df-meta">
      CRIPFCnt SCOI Framework · Special Structural Intelligence Audit<br>
      Authored by Donald Mataranyika · Chartered Secretary &amp; Governance Specialist<br>
      This report is an immutable reference document. Non-retroactive.
    </div>
  </footer>

</article>
</body>
</html>
