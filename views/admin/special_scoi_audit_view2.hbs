        <div class="chip-row">{{#each audit.civilizationFoundation.observedFoundation}}<span class="chip">{{this}}</span>{{/each}}</div>
      {{/if}}
      {{#if audit.civilizationFoundation.reportedCommunityReach}}
        <table class="kv-table"><tr><td>Reported community reach</td><td>{{audit.civilizationFoundation.reportedCommunityReach}}</td></tr></table>
      {{/if}}
      {{#if audit.civilizationFoundation.interpretation}}<div class="note-box">{{audit.civilizationFoundation.interpretation}}</div>{{/if}}
    </div>
    {{/if}}

