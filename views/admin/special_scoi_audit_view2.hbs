      {{#if audit.CRIPFCntInterpretation.keyDoctrine}}
        <div class="classification-block" style="margin-top:1.25rem;">
          <div class="class-label">Key Doctrine</div>
          <div class="class-def">{{audit.CRIPFCntInterpretation.keyDoctrine}}</div>
        </div>
      {{/if}}

      {{#if audit.CRIPFCntInterpretation.supportingDoctrine}}
        <div class="mini-head">Supporting doctrine</div>
        <div class="chip-row">{{#each audit.CRIPFCntInterpretation.supportingDoctrine}}<span class="chip">{{this}}</span>{{/each}}</div>
      {{/if}}

      {{#if audit.CRIPFCntInterpretation.structuralLesson}}
        <div class="lesson-box">
          <p style="font-family:var(--sans);font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--navy-light);margin-bottom:0.75rem;">Structural Lesson</p>
          <ul>
