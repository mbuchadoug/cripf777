        <div class="chip-row">{{#each audit.civilizationEconomicsAudit.transmissionChannels}}<span class="chip">{{this}}</span>{{/each}}</div>
      {{/if}}
      {{#if audit.civilizationEconomicsAudit.principle}}<p><strong>Principle.</strong> {{audit.civilizationEconomicsAudit.principle}}</p>{{/if}}
      {{#if audit.civilizationEconomicsAudit.boundary}}<div class="note-box"><strong>Boundary.</strong> {{audit.civilizationEconomicsAudit.boundary}}</div>{{/if}}
    </div>
