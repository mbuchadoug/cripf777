<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Course Engine · Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#12203f;--forest:#0b3a2a;--ink:#16241d;--mut:#66756c;--line:#e7ebe6;--bg:#f4f7f3;--ok:#1f9d6b}
*{box-sizing:border-box;margin:0}body{font-family:Archivo,system-ui,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit}
.nav{background:var(--navy);color:#fff;padding:14px clamp(16px,4vw,24px);display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
.nav a{color:#dbe4f5;text-decoration:none;font-weight:600;font-size:13.5px;margin-left:14px}.nav a.on{color:#fff}
.wrap{max-width:1040px;margin:0 auto;padding:clamp(18px,4vw,28px) clamp(16px,4vw,24px)}
h1{font-family:Fraunces,serif;font-size:26px;font-weight:600;margin-bottom:4px}
.lead{color:var(--mut);margin-bottom:18px;max-width:680px;font-size:14.5px}
.flash{background:#e7f6ee;border:1px solid #b7e3c9;color:#1f7a4d;padding:11px 14px;border-radius:10px;margin-bottom:16px;font-weight:600;font-size:14px}
.panel{background:#fff;border:1px solid var(--line);border-radius:15px;padding:clamp(16px,3vw,22px);margin-bottom:18px}
.panel h2{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin-bottom:14px}
label{display:block;font-size:12px;font-weight:700;color:var(--mut);margin:0 0 5px}
input,select{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:9px;font:inherit;background:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:8px}
.btn{background:var(--navy);color:#fff;border:0;font:inherit;font-weight:600;font-size:14px;padding:11px 18px;border-radius:10px;cursor:pointer;text-decoration:none;display:inline-block}
.btn.forest{background:var(--forest)}.btn.g{background:#fff;color:var(--navy);border:1px solid var(--line);padding:7px 12px;font-size:12.5px}
.mrow{display:grid;grid-template-columns:1.4fr 1fr 1fr .7fr;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line)}
.mrow .pn{font-weight:600;font-size:14px}
.mrow input{padding:8px 10px}
.mini{font-size:11px;color:var(--mut);font-weight:600}
.acc{border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}
.acc>summary{list-style:none;cursor:pointer;padding:13px 16px;background:#f0f2f6;font-weight:700;display:flex;justify-content:space-between;align-items:center}
.acc>summary::-webkit-details-marker{display:none}
.acc .body{padding:6px 14px 12px}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:640px}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);font-size:13px;white-space:nowrap}
th{font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:var(--mut)}
.tag{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px}
.tag.y{background:#e7f6ee;color:#1f7a4d}.tag.n{background:#f3e7e7;color:#a35}.tag.lock{background:#eee9f6;color:#5b3f9e}
form.inl{display:inline-flex;gap:5px;align-items:center;margin:0}
form.inl input{width:64px;padding:6px 8px}
.count{font-family:Fraunces,serif;font-weight:600}
</style></head><body>
<div class="nav"><b>CRIPFCnt · Course Engine</b><div><a href="/admin/courses">Courses</a><a href="/admin/enrollments">Enrollments</a><a href="/admin/module-tracks">Capstones</a><a href="/admin/course-engine" class="on">Engine</a><a href="/admin/learners">Learners</a></div></div>
<div class="wrap">
  <h1>Course Engine control center</h1>
  <div class="lead">The engine reads your assessment bank, turns each professional area into a course, files it under its module (one of the 8 CRIPFCnt pillars), and auto-selects default quizzes. Set the defaults here - the system fills the rest, and you override only where you want.</div>
  {{#if synced}}<div class="flash">✅ Sync complete - {{synced}}.</div>{{/if}}

  {{!-- SETTINGS + PER-MODULE --}}
  <form method="POST" action="/admin/course-engine/settings">
  <div class="panel">
    <h2>Global defaults</h2>
    <div class="grid">
      <div><label>Quizzes per course</label><input type="number" name="defaultQuizzesPerCourse" value="{{settings.defaultQuizzesPerCourse}}" min="1"></div>
      <div><label>Selection strategy</label><select name="selectionStrategy">
        <option value="balanced" {{#if (eq settings.selectionStrategy "balanced")}}selected{{/if}}>Balanced (spread across series)</option>
        <option value="first" {{#if (eq settings.selectionStrategy "first")}}selected{{/if}}>First N</option>
        <option value="random" {{#if (eq settings.selectionStrategy "random")}}selected{{/if}}>Random</option>
      </select></div>
      <div><label>Default level</label><select name="defaultLevel">
        <option value="foundation" {{#if (eq settings.defaultLevel "foundation")}}selected{{/if}}>Foundation</option>
        <option value="intermediate" {{#if (eq settings.defaultLevel "intermediate")}}selected{{/if}}>Intermediate</option>
        <option value="advanced" {{#if (eq settings.defaultLevel "advanced")}}selected{{/if}}>Advanced</option>
      </select></div>
      <div><label>Default access</label><select name="defaultAccessType">
        <option value="free" {{#if (eq settings.defaultAccessType "free")}}selected{{/if}}>Free</option>
        <option value="paid" {{#if (eq settings.defaultAccessType "paid")}}selected{{/if}}>Paid</option>
        <option value="invite" {{#if (eq settings.defaultAccessType "invite")}}selected{{/if}}>Invite</option>
      </select></div>
      <div><label>Default price</label><input type="number" name="defaultPrice" value="{{settings.defaultPrice}}" min="0" step="0.01"></div>
      <div><label>Auto-publish</label><select name="autoPublish"><option value="false" {{#unless settings.autoPublish}}selected{{/unless}}>No</option><option value="on" {{#if settings.autoPublish}}selected{{/if}}>Yes</option></select></div>
    </div>
  </div>

  <div class="panel">
    <h2>Payment methods</h2>
    <div class="grid">
      <div><label>EcoCash</label><select name="pay_ecocash"><option value="on" {{#if settings.payments.ecocash}}selected{{/if}}>Enabled</option><option value="false" {{#unless settings.payments.ecocash}}selected{{/unless}}>Off</option></select></div>
      <div><label>Card (Stripe)</label><select name="pay_stripe"><option value="on" {{#if settings.payments.stripe}}selected{{/if}}>Enabled</option><option value="false" {{#unless settings.payments.stripe}}selected{{/unless}}>Off</option></select></div>
      <div><label>Default method</label><select name="pay_default"><option value="ecocash" {{#if (eq settings.payments.defaultMethod "ecocash")}}selected{{/if}}>EcoCash</option><option value="stripe" {{#if (eq settings.payments.defaultMethod "stripe")}}selected{{/if}}>Card</option></select></div>
      <div><label>Currency</label><input name="pay_currency" value="{{settings.payments.currency}}" placeholder="USD"></div>
    </div>
  </div>

  <div class="panel">
    <h2>Per-module overrides (the 8 CRIPFCnt modules)</h2>
    <div class="mrow"><div class="mini">MODULE</div><div class="mini">QUIZZES / COURSE</div><div class="mini">MIN COURSES (capstone)</div><div class="mini">ENABLED</div></div>
    {{#each modules}}
    <div class="mrow">
      <div class="pn">{{this.label}}<input type="hidden" name="m_pillar" value="{{this.pillar}}"></div>
      <input type="number" name="m_quizzesPerCourse" value="{{this.quizzesPerCourse}}" placeholder="default" min="1">
      <input type="number" name="m_minCourses" value="{{this.minCoursesToComplete}}" placeholder="all" min="1">
      <label style="margin:0"><input type="checkbox" name="m_enabled" value="{{this.pillar}}" {{#if this.enabled}}checked{{/if}} style="width:auto"> on</label>
    </div>
    {{/each}}
    <div style="margin-top:14px"><button class="btn" type="submit">Save defaults &amp; module settings</button></div>
  </div>
  </form>

  {{!-- SYNC --}}
  <div class="panel">
    <h2>Build / re-sync the catalog</h2>
    <p style="font-size:14px;color:var(--mut);margin-bottom:12px">Generates a course for every mapped area and rebuilds the 8 module capstones. Safe to run repeatedly - hand-locked courses are left untouched unless you force a resync.</p>
    <form method="POST" action="/admin/course-engine/sync" style="display:flex;gap:14px;align-items:center;flex-wrap:wrap">
      <button class="btn forest" type="submit">⚙️ Build / Re-sync from question bank</button>
      <label style="margin:0;font-size:13px"><input type="checkbox" name="force" style="width:auto"> Force (overwrite locked courses)</label>
    </form>
  </div>

  {{!-- PER-MODULE COURSE MANAGEMENT --}}
  <h2 style="font-family:Fraunces,serif;font-size:19px;font-weight:600;margin:6px 0 12px">Courses by module</h2>
  {{#each modules}}
  <details class="acc" {{#if this.courses.length}}open{{/if}}>
    <summary><span>{{this.label}}</span><span class="mini">{{this.courses.length}} course(s)</span></summary>
    <div class="body tablewrap">
      <table>
        <tr><th>Course (area)</th><th>Quizzes</th><th>Set count</th><th>Access</th><th>State</th><th>Actions</th></tr>
        {{#each this.courses}}
        <tr>
          <td><b>{{this.title}}</b><br><span class="mini">{{this.area}}</span></td>
          <td><span class="count">{{this.selected}}</span> <span class="mini">/ {{this.pool}} in pool</span></td>
          <td>
            <form class="inl" method="POST" action="/admin/courses/{{this.id}}/quiz-target">
              <input type="number" name="target" value="{{this.target}}" placeholder="{{this.selected}}" min="0"><button class="btn g" type="submit">Apply</button>
            </form>
          </td>
          <td>{{this.access}}</td>
          <td>
            {{#if this.published}}<span class="tag y">Live</span>{{else}}<span class="tag n">Draft</span>{{/if}}
            {{#if this.customized}}<span class="tag lock">Locked</span>{{/if}}
          </td>
          <td>
            <form class="inl" method="POST" action="/admin/course-engine/{{this.id}}/publish"><button class="btn g">{{#if this.published}}Unpublish{{else}}Publish{{/if}}</button></form>
            <form class="inl" method="POST" action="/admin/courses/{{this.id}}/lock"><button class="btn g">{{#if this.customized}}Unlock{{else}}Lock{{/if}}</button></form>
            <a class="btn g" href="/admin/courses/{{this.id}}/edit">Edit</a>
          </td>
        </tr>
        {{else}}<tr><td colspan="6" class="mini">No courses yet - run a sync.</td></tr>{{/each}}
      </table>
    </div>
  </details>
  {{/each}}
</div></body></html>
