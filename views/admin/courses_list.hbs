<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Courses · Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#12203f;--ink:#16241d;--mut:#66756c;--line:#e7ebe6;--bg:#f4f7f3}
*{box-sizing:border-box;margin:0}body{font-family:Archivo,system-ui,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit}
.nav{background:var(--navy);color:#fff;padding:14px clamp(16px,4vw,24px);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
.nav a{color:#dbe4f5;text-decoration:none;font-weight:600;font-size:13.5px;margin-left:14px}
.wrap{max-width:1080px;margin:0 auto;padding:clamp(18px,4vw,28px) clamp(16px,4vw,24px)}
h1{font-family:Fraunces,serif;font-size:24px;font-weight:600;margin-bottom:14px}
.btn{background:var(--navy);color:#fff;text-decoration:none;font-size:13.5px;font-weight:600;padding:10px 16px;border-radius:9px;border:0;cursor:pointer;display:inline-block}
.btn.g{background:#fff;color:var(--navy);border:1px solid var(--line)}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:14px;min-width:760px}
th,td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);font-size:13.5px;white-space:nowrap}
th{background:#f0f2f6;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--mut)}
.pub{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px}.pub.y{background:#e7f6ee;color:#1f7a4d}.pub.n{background:#f3e7e7;color:#a35}
.acc{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:#eef3ee;color:#0b3a2a}
form{display:inline}
</style></head><body>
<div class="nav"><b>CRIPFCnt · Course Admin</b><div><a href="/admin/course-engine">Engine</a><a href="/admin/enrollments">Enrollments</a><a href="/admin/module-tracks">Capstones</a><a class="btn" href="/admin/courses/new" style="margin-left:14px">+ New course</a></div></div>
<div class="wrap"><h1>Courses</h1>
<div class="tablewrap"><table>
  <tr><th>Title</th><th>Area</th><th>Access</th><th>Price</th><th>Quizzes</th><th>Enrolled</th><th>Status</th><th>Actions</th></tr>
  {{#each courses}}
  <tr>
    <td><b>{{this.title}}</b><br><span style="color:var(--mut);font-size:12px">/{{this.slug}}</span></td>
    <td>{{this.area}}</td>
    <td><span class="acc">{{this.access}}</span></td>
    <td>{{this.price}}</td>
    <td>{{this.totalQuizzes}} · {{this.units}}u</td>
    <td>{{this.enrolled}}</td>
    <td>{{#if this.published}}<span class="pub y">Published</span>{{else}}<span class="pub n">Draft</span>{{/if}}</td>
    <td>
      <a class="btn g" href="/admin/courses/{{this.id}}/edit">Edit</a>
      <form method="POST" action="/admin/courses/{{this.id}}/publish"><button class="btn g">{{#if this.published}}Unpublish{{else}}Publish{{/if}}</button></form>
      <form method="POST" action="/admin/courses/{{this.id}}/delete" onsubmit="return confirm('Delete course?')"><button class="btn g" style="color:#a35">Delete</button></form>
    </td>
  </tr>
  {{else}}<tr><td colspan="8" style="color:var(--mut)">No courses yet. Click “New course”.</td></tr>{{/each}}
</table></div></div></body></html>
