<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{#if isEdit}}Edit{{else}}New{{/if}} Course · Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#12203f;--gold:#b8860b;--ink:#16241d;--mut:#6b7a72;--line:#e5e9e4;--bg:#f6f8f5}
*{box-sizing:border-box;margin:0}body{font-family:Archivo,sans-serif;color:var(--ink);background:var(--bg)}
.top{background:var(--navy);color:#fff;padding:14px 24px}.top a{color:#fff;text-decoration:none}
.wrap{max-width:960px;margin:0 auto;padding:24px}
h1{font-family:Fraunces,serif;font-size:24px;font-weight:600;margin-bottom:6px}
.hint{color:var(--mut);font-size:13px;margin-bottom:18px}
.panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:16px}
.panel h2{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin-bottom:12px}
label{display:block;font-size:12px;font-weight:600;color:var(--mut);margin:0 0 4px}
input,select,textarea{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:8px;font:inherit;background:#fff}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.row{margin-bottom:12px}
.series{border:1px solid var(--line);border-radius:10px;margin-bottom:10px;overflow:hidden}
.series h3{background:#f0f2ef;padding:9px 12px;font-size:13px;font-weight:700;display:flex;justify-content:space-between}
.qz{display:flex;align-items:center;gap:10px;padding:8px 12px;border-top:1px solid var(--line);font-size:14px}
.qz input{width:auto}.qz .b{font-size:11px;color:var(--mut);text-transform:capitalize;margin-left:auto}
.btn{background:var(--navy);color:#fff;border:0;font-size:14px;font-weight:600;padding:11px 20px;border-radius:9px;cursor:pointer}
.btn.g{background:#fff;color:var(--navy);border:1px solid var(--line);text-decoration:none;display:inline-block}
.areabar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.areabar a{font-size:12px;padding:6px 10px;border:1px solid var(--line);border-radius:20px;text-decoration:none;color:var(--ink);background:#fff}
.areabar a.on{background:var(--navy);color:#fff;border-color:var(--navy)}
small.k{color:var(--mut)}
</style></head><body>
<div class="top"><a href="/admin/courses">← Courses</a></div>
<div class="wrap">
<h1>{{#if isEdit}}Edit course{{else}}New course{{/if}}</h1>
<div class="hint">Pick a professional area, tick the assessments to include, and set the pass standard. Out-of-scope items are hidden automatically. Selected quizzes are grouped into units by their series.</div>

<div class="areabar">
  {{#each areas}}<a class="{{#if (eq this.slug ../area)}}on{{/if}}" href="/admin/courses/new?area={{this.slug}}">{{this.label}}</a>{{/each}}
</div>

<form method="POST" action="/admin/courses">
  {{#if course.id}}<input type="hidden" name="id" value="{{course.id}}">{{/if}}
  <input type="hidden" name="area" value="{{area}}">

  <div class="panel">
    <h2>Course details · {{areaLabel}}</h2>
    <div class="row"><label>Title</label><input name="title" value="{{course.title}}" placeholder="{{areaLabel}}" required></div>
    <div class="grid2">
      <div class="row"><label>URL slug (optional)</label><input name="slug" value="{{course.slug}}" placeholder="auto from title"></div>
      <div class="row"><label>Level</label><select name="level">
        <option value="foundation" {{#if (eq course.level "foundation")}}selected{{/if}}>Foundation</option>
        <option value="intermediate" {{#if (eq course.level "intermediate")}}selected{{/if}}>Intermediate</option>
        <option value="advanced" {{#if (eq course.level "advanced")}}selected{{/if}}>Advanced</option>
      </select></div>
    </div>
    <div class="row"><label>Description</label><textarea name="description" rows="2">{{course.description}}</textarea></div>
  </div>

  <div class="panel">
    <h2>Pass standard</h2>
    <div class="grid3">
      <div class="row"><label>Pass mark per quiz (%)</label><input type="number" name="perQuizPassMark" value="{{course.rules.perQuizPassMark}}" min="0" max="100"></div>
      <div class="row"><label>Min quizzes to pass <small class="k">(blank = all)</small></label><input type="number" name="minQuizzesToPass" value="{{course.rules.minQuizzesToPass}}" min="0"></div>
      <div class="row"><label>Overall pass mark (%)</label><input type="number" name="overallPassMark" value="{{course.rules.overallPassMark}}" min="0" max="100"></div>
    </div>
    <div class="grid3">
      <div class="row"><label>Max attempts / quiz</label><input type="number" name="maxAttempts" value="{{course.rules.maxAttempts}}" min="1"></div>
      <div class="row"><label>Cooldown (hours)</label><input type="number" name="cooldownHours" value="{{course.rules.cooldownHours}}" min="0"></div>
      <div class="row"><label>Weighting</label><select name="weighting">
        <option value="equal" {{#if (eq course.weighting "equal")}}selected{{/if}}>Equal</option>
        <option value="by_difficulty" {{#if (eq course.weighting "by_difficulty")}}selected{{/if}}>By difficulty (harder counts more)</option>
      </select></div>
    </div>
    <div class="grid3">
      <div class="row"><label>Band · Pass ≥</label><input type="number" name="bandPass" value="70"></div>
      <div class="row"><label>Band · Merit ≥</label><input type="number" name="bandMerit" value="80"></div>
      <div class="row"><label>Band · Distinction ≥</label><input type="number" name="bandDistinction" value="90"></div>
    </div>
    <div class="row"><label><input type="checkbox" name="published" style="width:auto"> Publish now</label></div>
  </div>

  <div class="panel">
    <h2>Enrollment &amp; pricing</h2>
    <div class="grid3">
      <div class="row"><label>Access type</label><select name="accessType">
        <option value="free" {{#if (eq course.accessType "free")}}selected{{/if}}>Free (instant enrol)</option>
        <option value="paid" {{#if (eq course.accessType "paid")}}selected{{/if}}>Paid (EcoCash / card)</option>
        <option value="invite" {{#if (eq course.accessType "invite")}}selected{{/if}}>Invite only (admin enrols)</option>
      </select></div>
      <div class="row"><label>Price</label><input type="number" name="price" value="{{course.price}}" min="0" step="0.01"></div>
      <div class="row"><label>Currency</label><input name="currency" value="{{course.currency}}" placeholder="USD"></div>
    </div>
    <div class="row"><label><input type="checkbox" name="enrollmentOpen" style="width:auto" {{#if course.enrollmentOpen}}checked{{/if}}> Allow self-enrolment</label></div>
  </div>

  <div class="panel">
    <h2>Select assessments ({{areaLabel}})</h2>
    <style>
      .qtoolbar{position:sticky;top:0;z-index:5;background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
      .qtoolbar input.q{flex:1;min-width:170px;padding:9px 12px;border:1px solid var(--line);border-radius:8px;font:inherit}
      .qtoolbar .cnt{font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap}
      .qtoolbar button{background:#fff;border:1px solid var(--line);border-radius:8px;font:inherit;font-size:12px;font-weight:600;padding:8px 11px;cursor:pointer}
      .qtoolbar button.on{background:#e7efff;border-color:#b9cdf0}
      details.series{border:1px solid var(--line);border-radius:10px;margin-bottom:8px;overflow:hidden}
      details.series>summary{list-style:none;cursor:pointer;padding:10px 12px;background:#f0f2ef;display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700}
      details.series>summary::-webkit-details-marker{display:none}
      details.series>summary .b{margin-left:auto;font-weight:600;color:var(--mut)}
      .selall{font-size:11px;font-weight:600;color:var(--navy);display:flex;align-items:center;gap:4px;cursor:pointer}
      .qempty{font-size:12px;color:var(--mut);padding:8px 12px;display:none}
    </style>
    <div class="qtoolbar">
      <input class="q" id="qsearch" type="search" placeholder="Search assessments by title or series..." oninput="qfilter()">
      <span class="cnt" id="qcount">0 selected</span>
      <button type="button" id="qonly" onclick="qselectedOnly()">Selected only</button>
      <button type="button" onclick="qexpand(true)">Expand all</button>
      <button type="button" onclick="qexpand(false)">Collapse all</button>
      <button type="button" onclick="qclear()">Clear</button>
    </div>
    <div id="qlist">
    {{#each series}}
    <details class="series" data-series="{{this.seriesLabel}}">
      <summary>
        <label class="selall" onclick="event.stopPropagation()"><input type="checkbox" onchange="qtoggleSeries(this)"> all</label>
        <span>{{this.seriesLabel}}</span><span class="b">{{this.quizzes.length}} available</span>
      </summary>
      <div class="sbody">
      {{#each this.quizzes}}
      <label class="qz" data-title="{{this.title}}"><input type="checkbox" name="quizIds" value="{{this.id}}" {{#if this.checked}}checked{{/if}} onchange="qcountUpdate()">
        <span>{{this.title}}</span><span class="b">{{this.band}} - {{this.qCount}}q</span></label>
      {{/each}}
      <div class="qempty">No matches in this series.</div>
      </div>
    </details>
    {{else}}<p class="hint">No in-scope assessments in this area.</p>{{/each}}
    </div>
    <script>
    function qcountUpdate(){document.getElementById('qcount').textContent=document.querySelectorAll('#qlist input[name=quizIds]:checked').length+' selected';}
    function qfilter(){
      var term=(document.getElementById('qsearch').value||'').trim().toLowerCase();
      document.querySelectorAll('#qlist details.series').forEach(function(d){
        var series=(d.getAttribute('data-series')||'').toLowerCase(),any=false;
        d.querySelectorAll('.qz').forEach(function(l){
          var t=(l.getAttribute('data-title')||'').toLowerCase();
          var match=!term||t.indexOf(term)>-1||series.indexOf(term)>-1;
          l.style.display=match?'':'none'; if(match)any=true;
        });
        d.style.display=any?'':'none';
        if(term&&any)d.open=true;
        d.querySelector('.qempty').style.display=any?'none':'';
      });
    }
    function qtoggleSeries(cb){cb.closest('details').querySelectorAll('.qz').forEach(function(l){if(l.style.display!=='none'){l.querySelector('input[name=quizIds]').checked=cb.checked;}});qcountUpdate();}
    function qselectedOnly(){
      var btn=document.getElementById('qonly');var on=btn.classList.toggle('on');
      document.querySelectorAll('#qlist details.series').forEach(function(d){
        var any=false;
        d.querySelectorAll('.qz').forEach(function(l){var c=l.querySelector('input').checked;var show=!on||c;l.style.display=show?'':'none';if(show)any=true;});
        d.style.display=any?'':'none'; if(on)d.open=true;
      });
    }
    function qexpand(v){document.querySelectorAll('#qlist details.series').forEach(function(d){d.open=v;});}
    function qclear(){document.querySelectorAll('#qlist input[name=quizIds]').forEach(function(i){i.checked=false;});qcountUpdate();}
    document.querySelectorAll('#qlist details.series').forEach(function(d){ if(d.querySelector('input[name=quizIds]:checked')) d.open=true; });
    qcountUpdate();
    </script>
  </div>

  <button class="btn" type="submit">{{#if isEdit}}Save changes{{else}}Create course{{/if}}</button>
  <a class="btn g" href="/admin/courses">Cancel</a>
</form>
</div></body></html>
