<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Parent Dashboard</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  <style>
    :root{
      --gold:#D4AF37;
      --gold-soft:#f6e6b3;
      --silver:#C0C0C0;
      --bg:#0b0b0b;
      --panel:#141414;
      --panel-2:#1a1a1a;
      --border:#242424;
      --muted:#9aa3ad;
      --radius:16px;
      --green:#1db954;
      --amber:#f59e0b;
      --red:#c0392b;
      --blue:#1e90ff;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      background:var(--bg);
      color:#fff;
      font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
    }
    main{
      width:100%;
      max-width:1200px;
      margin:clamp(16px,4vw,32px) auto;
      padding:0 clamp(14px,4vw,24px);
    }
    a{color:inherit}
    h1{ font-size:clamp(22px,5vw,30px); margin:0 0 6px; }
    h2{ margin:26px 0 12px; color:var(--gold); font-size:clamp(17px,3.5vw,20px); }
    h3{ margin:0 0 8px; font-size:17px; }
    .note{ color:var(--muted); font-size:14px; line-height:1.5; margin:0; }

    .panel{
      background:var(--panel);
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:clamp(16px,3vw,22px);
      margin-bottom:16px;
    }

    .btn{
      display:inline-flex; align-items:center; justify-content:center; gap:8px;
      background:var(--gold); color:#111; border:none; border-radius:10px;
      padding:11px 16px; font-size:14px; font-weight:700; cursor:pointer;
      text-decoration:none; transition:filter .15s, transform .05s; white-space:nowrap;
    }
    .btn:hover{ filter:brightness(1.08) }
    .btn:active{ transform:translateY(1px) }
    .btn.block{ width:100%; }
    .btn.ghost{ background:transparent; color:#fff; border:1px solid var(--border); }
    .btn.ghost:hover{ border-color:var(--gold); color:var(--gold); }
    .btn.blue{ background:var(--blue); color:#fff; }
    .btn.green{ background:var(--green); color:#fff; }
    .btn.silver{ background:var(--silver); color:#111; }
    .btn.sm{ padding:8px 12px; font-size:13px; }
    .btn[disabled]{ opacity:.55; cursor:not-allowed; }

    /* ---------- header ---------- */
    .top-actions{
      display:flex; justify-content:space-between; align-items:flex-start;
      gap:14px; flex-wrap:wrap; margin-bottom:8px;
    }
    .top-actions .actions{ display:flex; gap:10px; flex-wrap:wrap; }

    /* ---------- subscription status ---------- */
    .sub-card{
      display:flex; align-items:center; justify-content:space-between;
      gap:16px; flex-wrap:wrap;
      background:linear-gradient(135deg,#161616,#101010);
      border:1px solid var(--border); border-left:4px solid var(--muted);
      border-radius:var(--radius); padding:clamp(16px,3vw,20px); margin-bottom:16px;
    }
    .sub-card.active{ border-left-color:var(--green); }
    .sub-card.expired{ border-left-color:var(--red); }
    .sub-card.pending{ border-left-color:var(--amber); }
    .sub-left{ display:flex; align-items:center; gap:14px; min-width:240px; flex:1; }
    .sub-emoji{ font-size:26px; line-height:1; }
    .status-badge{
      display:inline-block; padding:3px 10px; border-radius:999px;
      font-size:12px; font-weight:800; letter-spacing:.3px;
      background:rgba(154,163,173,.18); color:var(--muted);
    }
    .status-badge.active{ background:rgba(29,185,84,.15); color:#4ade80; }
    .status-badge.expired{ background:rgba(192,57,43,.15); color:#f87171; }
    .status-badge.pending{ background:rgba(245,158,11,.15); color:#fbbf24; }
    .sub-meta{ font-size:13px; color:var(--muted); margin-top:4px; }
    .sub-meta b{ color:#fff; }

    /* ---------- children grid ---------- */
    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));
      gap:16px;
    }
    .child-card{
      background:var(--panel); border:1px solid var(--border);
      border-radius:var(--radius); padding:18px;
      display:flex; flex-direction:column; gap:14px;
    }
    .child-head{ display:flex; align-items:center; gap:12px; }
    .avatar{
      width:44px; height:44px; border-radius:12px; flex-shrink:0;
      display:flex; align-items:center; justify-content:center;
      font-weight:800; font-size:18px; color:#111;
      background:linear-gradient(135deg,var(--gold),#b8912f);
    }
    .child-name{ font-weight:800; font-size:16px; }
    .child-meta{ color:var(--muted); font-size:13px; margin-top:2px; }
    .grade-pill{
      display:inline-block; padding:2px 9px; border-radius:999px; font-size:12px; font-weight:700;
      background:rgba(212,175,55,.14); color:var(--gold-soft); border:1px solid rgba(212,175,55,.3);
    }
    .grade-pill.unset{ background:rgba(245,158,11,.14); color:#fbbf24; border-color:rgba(245,158,11,.35); }

    .stats{ display:flex; gap:10px; flex-wrap:wrap; }
    .stat{
      flex:1; min-width:70px; text-align:center;
      background:var(--panel-2); border:1px solid var(--border);
      border-radius:10px; padding:8px 6px;
    }
    .stat b{ display:block; font-size:18px; }
    .stat span{ font-size:11px; color:var(--muted); }

    .card-actions{ display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:auto; }
    .card-actions .full{ grid-column:1 / -1; }

    /* ---------- plans ---------- */
    .plan-grid{
      display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:16px;
    }
    .plan-card{
      background:var(--panel); border:1px solid var(--border);
      border-radius:var(--radius); padding:22px; position:relative; text-align:center;
    }
    .silver-border{ border-color:rgba(192,192,192,.5); }
    .gold-border{ border-color:var(--gold); }
    .plan-badge{
      display:inline-block; padding:5px 14px; border-radius:999px;
      font-size:12px; font-weight:800; letter-spacing:.5px; margin-bottom:12px;
    }
    .badge-silver{ background:var(--silver); color:#111; }
    .badge-gold{ background:var(--gold); color:#111; }
    .plan-price{ font-size:38px; font-weight:800; }
    .plan-period{ color:var(--muted); font-size:13px; margin-bottom:14px; }
    .plan-features{ list-style:none; padding:0; margin:0 0 18px; text-align:left; }
    .plan-features li{ padding:7px 0; border-bottom:1px solid var(--border); font-size:14px; }
    .plan-features li:last-child{ border-bottom:none; }
    .plan-features li::before{ content:"✓"; color:var(--green); font-weight:800; margin-right:8px; }

    .included li{ list-style:none; }
    .mock-subject-row{ display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); font-size:14px; }
    .mock-subject-row:last-child{ border-bottom:none; }
    .mock-dot{ width:8px; height:8px; border-radius:50%; flex-shrink:0; }

    .empty{ font-size:16px; margin-bottom:6px; }

    @media (max-width:520px){
      .card-actions{ grid-template-columns:1fr; }
      .top-actions .actions{ width:100%; }
      .top-actions .actions .btn{ flex:1; }
    }
  </style>
</head>

<body>
<main>

  <!-- HEADER -->
  <div class="top-actions">
    <div>
      <h1>Parent Dashboard</h1>
      <p class="note">Manage your children's learning, quizzes, grades and credentials.</p>
    </div>
    <div class="actions">
      <a href="/org/cripfcnt-school/dashboard" class="btn blue">Switch to CRIPFCnt Academy</a>
      {{#if canAddChild}}
        <a href="/parent/children/new" class="btn green">➕ Add Child</a>
      {{/if}}
    </div>
  </div>

  <!-- SUBSCRIPTION STATUS (always visible - confirms paid state) -->
  <div class="sub-card {{#if isPaid}}active{{else if isExpired}}expired{{else if isPaidPlan}}pending{{/if}}">
    <div class="sub-left">
      <span class="sub-emoji">{{#if isPaid}}✅{{else if isExpired}}⌛{{else if isPaidPlan}}⚠️{{else}}🎓{{/if}}</span>
      <div>
        <div>
          <span class="status-badge {{#if isPaid}}active{{else if isExpired}}expired{{else if isPaidPlan}}pending{{/if}}">
            {{subscriptionStatusText}}
          </span>
          <strong style="margin-left:8px;text-transform:capitalize;">{{planLabel}}</strong>
        </div>
        <div class="sub-meta">
          {{#if isPaid}}
            Renews / expires <b>{{subExpiryText}}</b>{{#if daysRemaining}} · <b>{{daysRemaining}} days</b> left{{/if}}
          {{else if isExpired}}
            Your plan expired on <b>{{subExpiryText}}</b>. Renew to unlock the full quiz library again.
          {{else if isPaidPlan}}
            Plan <b>{{planName}}</b> is set but not active yet. If you just paid, it may still be processing - otherwise complete payment below.
          {{else}}
            You're on the free trial. Subscribe to unlock the full quiz library across all grades.
          {{/if}}
        </div>
      </div>
    </div>
    <div>
      {{#unless isPaid}}
        {{#if (eq planName "silver")}}
          <button class="btn" onclick="openPayModal('gold', 'Gold Plan', 10)">💎 Get Gold ($10/mo)</button>
        {{else}}
          <button class="btn" onclick="openPayModal('gold', 'Gold Plan', 10)">🚀 Subscribe</button>
        {{/if}}
      {{/unless}}
    </div>
  </div>

  <!-- ============================== -->
  <!-- 👧 MY CHILDREN (always shown)  -->
  <!-- ============================== -->
  <h2>My Children</h2>

  {{#if children.length}}
    <div class="grid">
      {{#each children}}
        <div class="child-card">
          <div class="child-head">
            <div class="avatar">{{initial}}</div>
            <div>
              <div class="child-name">{{firstName}} {{lastName}}</div>
              <div class="child-meta">
                <span class="grade-pill {{#unless hasGrade}}unset{{/unless}}">{{gradeLabel}}</span>
                {{#if studentId}} · ID: {{studentId}}{{/if}}
              </div>
            </div>
          </div>

          <div class="stats">
            <div class="stat"><b>{{pendingCount}}</b><span>Pending</span></div>
            <div class="stat"><b>{{completedCount}}</b><span>Completed</span></div>
            <div class="stat"><b>{{#if avgScore}}{{avgScore}}%{{else}}-{{/if}}</b><span>Avg score</span></div>
            <div class="stat"><b>{{certificateCount}}</b><span>Certs</span></div>
          </div>

          <div class="card-actions">
            <a href="/parent/children/{{_id}}/quizzes" class="btn sm full">▶ Enter Account</a>
            <a href="/parent/children/{{_id}}/knowledge-map" class="btn sm ghost">🗺️ Knowledge Map</a>
            <a href="/parent/children/{{_id}}/edit" class="btn sm ghost">🎓 Set Grade</a>
            <a href="/parent/children/{{_id}}/credentials" class="btn sm ghost">🔑 Credentials</a>
            <a href="/parent/children/{{_id}}/edit" class="btn sm ghost">✏️ Edit Details</a>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="panel">
      <div class="empty">No children added yet.</div>
      <p class="note" style="margin-bottom:14px;">Register your learner to assign quizzes, grades and login credentials.</p>
      {{#if canAddChild}}
        <a href="/parent/children/new" class="btn green">➕ Add Child</a>
      {{else}}
        <a href="/parent/trial/new" class="btn green">🎯 Start Free Trial</a>
      {{/if}}
    </div>
  {{/if}}

  {{#if canAddChild}}
    <p class="note" style="margin:10px 2px 0;">You can add {{childLimit}} children on your plan ({{childCount}}/{{childLimit}} used).</p>
  {{else}}
    {{#if isPaid}}
      <p class="note" style="margin:10px 2px 0;">📌 Child limit reached ({{childCount}}/{{childLimit}}). Upgrade for more.</p>
    {{/if}}
  {{/if}}

  <!-- ============================== -->
  <!-- 💳 SUBSCRIBE / RENEW           -->
  <!-- ============================== -->
  {{#unless isPaid}}

    <!-- WHAT'S INCLUDED -->
    <div class="panel" style="margin-top:26px;">
      <h3 style="color:var(--gold);">✨ What's Included</h3>
      <div class="mock-subject-row"><div class="mock-dot" style="background:var(--green)"></div><span>1 free trial quiz per subject so your child can try before you buy</span></div>
      <div class="mock-subject-row"><div class="mock-dot" style="background:var(--gold)"></div><span>Full quiz library unlocked per grade after subscribing</span></div>
      <div class="mock-subject-row"><div class="mock-dot" style="background:#6c63ff"></div><span>Progress tracking, score analytics and performance trends</span></div>
      <div class="mock-subject-row"><div class="mock-dot" style="background:var(--red)"></div><span>Certificates awarded on quiz completion</span></div>
    </div>

    <!-- PLAN SELECTION -->
    <div id="plans">
      <h2>Choose Your Plan</h2>
      <div class="plan-grid">
        <div class="plan-card silver-border">
          <span class="plan-badge badge-silver">Silver</span>
          <div class="plan-price">$5</div>
          <div class="plan-period">per month</div>
          <ul class="plan-features">
            <li>Up to 2 children</li>
            <li>1 trial quiz per subject (free)</li>
            <li>Full paid quiz library</li>
            <li>Progress tracking &amp; reports</li>
            <li>Certificates</li>
          </ul>
          <button class="btn silver block" onclick="openPayModal('silver', 'Silver Plan', 5)">📱 Get Silver</button>
        </div>

        <div class="plan-card gold-border">
          <span class="plan-badge badge-gold">Gold</span>
          <div class="plan-price">$10</div>
          <div class="plan-period">per month</div>
          <ul class="plan-features">
            <li>Up to 5 children</li>
            <li>1 trial quiz per subject (free)</li>
            <li>Full paid quiz library</li>
            <li>Progress tracking &amp; reports</li>
            <li>Certificates</li>
            <li>Priority support</li>
          </ul>
          {{#if (eq planName "silver")}}
            <button class="btn block" onclick="openPayModal('gold', 'Gold Plan', 10)">💎 Upgrade to Gold</button>
          {{else}}
            <button class="btn block" onclick="openPayModal('gold', 'Gold Plan', 10)">📱 Get Gold</button>
          {{/if}}
        </div>
      </div>
    </div>

  {{/unless}}

  <!-- UPGRADE BANNER (active Silver) -->
  {{#if isPaid}}
    {{#unless isExpired}}
      {{#if (eq planName "silver")}}
        <div class="sub-card pending" style="margin-top:26px;">
          <div class="sub-left">
            <span class="sub-emoji">💎</span>
            <div>
              <div><strong>Upgrade to Gold - add up to 5 children</strong></div>
              <div class="sub-meta"><b>{{daysRemaining}} days</b> of Silver credited to Gold · Priority support included</div>
            </div>
          </div>
          <div><button class="btn" onclick="openPayModal('gold', 'Gold Plan', 10)">Upgrade ($10/mo) →</button></div>
        </div>
      {{/if}}
    {{/unless}}
  {{/if}}

  <!-- RENEW IF EXPIRED -->
  {{#if isExpired}}
    <div id="plans">
      <h2>Renew Your Plan</h2>
      <div class="plan-grid">
        <div class="plan-card silver-border">
          <span class="plan-badge badge-silver">Silver</span>
          <div class="plan-price">$5</div>
          <div class="plan-period">per month · 2 children</div>
          <form method="POST" action="/payments/paynow/init">
            <input type="hidden" name="plan" value="silver">
            <button class="btn silver block" type="submit">💳 Renew Silver</button>
          </form>
        </div>
        <div class="plan-card gold-border">
          <span class="plan-badge badge-gold">Gold</span>
          <div class="plan-price">$10</div>
          <div class="plan-period">per month · 5 children</div>
          <form method="POST" action="/payments/paynow/init">
            <input type="hidden" name="plan" value="gold">
            <button class="btn block" type="submit">💳 Renew Gold</button>
          </form>
        </div>
      </div>
    </div>
  {{/if}}

  <!-- TRUST -->
  <div class="panel" style="margin-top:26px;">
    <strong style="color:var(--gold)">🔒 Parent Controlled Access</strong>
    <p class="note" style="margin-top:6px;">Only you can view your children's quizzes, results and certificates.</p>
  </div>

</main>
{{> ecocash_modal}}
</body>
</html>
