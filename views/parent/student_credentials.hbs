<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{childName}} · Login Details</title>
  <style>
    :root{
      --gold:#D4AF37; --bg:#0b0b0b; --panel:#141414; --panel2:#1a1a1a;
      --border:#242424; --muted:#9aa3ad; --green:#1db954; --amber:#f59e0b;
    }
    *{box-sizing:border-box}
    body{
      margin:0; min-height:100vh; background:var(--bg); color:#fff;
      font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
      display:flex; align-items:center; justify-content:center; padding:24px;
    }
    .card{
      width:100%; max-width:460px; background:var(--panel);
      border:1px solid var(--border); border-radius:18px; padding:26px 24px;
      box-shadow:0 20px 60px rgba(0,0,0,.45);
    }
    h2{ margin:0 0 6px; font-size:21px; }
    .sub{ color:var(--muted); font-size:14px; margin:0 0 20px; line-height:1.5; }
    .row{
      display:flex; justify-content:space-between; align-items:center; gap:12px;
      background:var(--panel2); border:1px solid var(--border);
      border-radius:12px; padding:14px 16px; margin-bottom:12px;
    }
    .row .label{ font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; }
    .row .value{ font-size:18px; font-weight:800; letter-spacing:1px; }
    .pin .value{ color:var(--gold); font-size:26px; letter-spacing:4px; }
    .warn{
      background:rgba(245,158,11,.10); border:1px solid rgba(245,158,11,.35);
      color:#fbbf24; border-radius:10px; padding:10px 12px; font-size:13px; margin:8px 0 16px;
    }
    .btn{
      display:inline-flex; align-items:center; justify-content:center; gap:8px;
      width:100%; border:none; border-radius:10px; padding:12px 16px;
      font-size:14px; font-weight:700; cursor:pointer; text-decoration:none; margin-top:6px;
    }
    .btn.gold{ background:var(--gold); color:#111; }
    .btn.ghost{ background:transparent; color:#fff; border:1px solid var(--border); }
    .btn.ghost:hover{ border-color:var(--gold); color:var(--gold); }
    .copy{
      background:none; border:1px solid var(--border); color:var(--muted);
      border-radius:8px; padding:6px 10px; font-size:12px; cursor:pointer; white-space:nowrap;
    }
    .copy:hover{ color:#fff; border-color:var(--gold); }
    .login-line{ font-size:13px; color:var(--muted); margin:14px 0 4px; }
    .login-line b{ color:#fff; }
  </style>
</head>
<body>
  <div class="card">
    {{#if (eq mode "created")}}
      <h2>✅ New PIN generated</h2>
      <p class="sub">Save these details for <strong>{{childName}}</strong>. This PIN is shown once and won't be displayed again.</p>
    {{else}}
      <h2>🔑 {{childName}}'s login details</h2>
      <p class="sub">Your child signs in with their Student ID and PIN. For security the current PIN can't be shown - reset it below to set a new one.</p>
    {{/if}}

    <div class="row">
      <div>
        <div class="label">Student ID</div>
        <div class="value" id="sid">{{studentId}}</div>
      </div>
      <button class="copy" onclick="copyText('{{studentId}}', this)">Copy</button>
    </div>

    {{#if pin}}
      <div class="row pin">
        <div>
          <div class="label">PIN</div>
          <div class="value">{{pin}}</div>
        </div>
        <button class="copy" onclick="copyText('{{pin}}', this)">Copy</button>
      </div>
      <div class="warn">⚠️ Write this PIN down now. You won't be able to see it again - you can only reset it.</div>
    {{/if}}

    <div class="login-line">Student login: <b>{{loginUrl}}</b></div>

    {{#unless (eq mode "created")}}
      <form method="POST" action="/parent/children/{{childId}}/reset-pin"
            onsubmit="return confirm('Generate a new PIN for {{childName}}? The old PIN will stop working.');">
        <button class="btn gold" type="submit">🔄 Reset PIN</button>
      </form>
    {{/unless}}

    <a href="{{dashboardUrl}}" class="btn ghost">← Back to Dashboard</a>
  </div>

  <script>
    function copyText(t, btn){
      navigator.clipboard.writeText(t).then(function(){
        var old = btn.textContent; btn.textContent = "Copied";
        setTimeout(function(){ btn.textContent = old; }, 1400);
      }).catch(function(){});
    }
  </script>
</body>
</html>
