<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>My Credentials · CRIPFCnt</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Archivo:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--forest:#0b3a2a;--gold:#c9a765;--ink:#16241d;--mut:#6b7a72;--line:#e5e9e4;--bg:#f6f8f5}
*{box-sizing:border-box;margin:0}body{font-family:Archivo,sans-serif;color:var(--ink);background:var(--bg)}
.top{background:var(--forest);color:#eafff4;padding:14px 24px}.top a{color:var(--gold);text-decoration:none}
.wrap{max-width:820px;margin:0 auto;padding:26px 24px}
h1{font-family:Fraunces,serif;font-size:28px;font-weight:600;margin-bottom:16px}
h2{font-family:Fraunces,serif;font-size:18px;margin:22px 0 10px}
.c{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.c .t{font-weight:700}.c .m{font-size:13px;color:var(--mut)}
.dl{background:var(--forest);color:#fff;text-decoration:none;font-size:13px;font-weight:600;padding:8px 14px;border-radius:8px}
</style></head><body>
<div class="top"><a href="/courses">← Courses</a></div>
<div class="wrap"><h1>My Credentials</h1>
<h2>Module Mastery</h2>
{{#each moduleCerts}}<div class="c"><div><div class="t">{{this.title}} — {{this.grade}}</div><div class="m">{{this.pct}}% · {{this.serial}}</div></div>{{#if this.url}}<a class="dl" href="{{this.url}}">Download</a>{{/if}}</div>{{else}}<div class="m">No module certificates yet.</div>{{/each}}
<h2>Area Courses</h2>
{{#each courseCerts}}<div class="c"><div><div class="t">{{this.title}} — {{this.grade}}</div><div class="m">{{this.area}} · {{this.pct}}% · {{this.serial}}</div></div>{{#if this.url}}<a class="dl" href="{{this.url}}">Download</a>{{/if}}</div>{{else}}<div class="m">No course certificates yet.</div>{{/each}}
</div></body></html>
