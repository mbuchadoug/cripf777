<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Professional Courses · CRIPFCnt</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--forest:#0b3a2a;--forest2:#0f4a35;--gold:#c9a765;--ink:#16241d;--mut:#66756c;--line:#e7ebe6;--bg:#f4f7f3;--card:#fff;--ok:#1f9d6b}
*{box-sizing:border-box;margin:0}html{-webkit-text-size-adjust:100%}
body{font-family:Archivo,system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.5}
a{color:inherit}
.nav{position:sticky;top:0;z-index:20;background:rgba(11,58,42,.98);color:#eafff4;padding:14px clamp(16px,4vw,28px);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.nav .brand{font-family:Fraunces,serif;font-weight:600;font-size:19px}
.nav .links{display:flex;gap:6px;flex-wrap:wrap}
.nav .links a{color:#cfe9dc;text-decoration:none;font-size:13.5px;font-weight:600;padding:7px 12px;border-radius:8px}
.nav .links a:hover{background:rgba(255,255,255,.08);color:#fff}
.nav .links a.cta{background:var(--gold);color:#3a2c07}
.hero{background:linear-gradient(160deg,var(--forest),var(--forest2));color:#eafff4;padding:clamp(28px,6vw,56px) clamp(16px,4vw,28px)}
.hero .in{max-width:1100px;margin:0 auto}
.hero h1{font-family:Fraunces,serif;font-weight:600;font-size:clamp(26px,5vw,40px);line-height:1.1;margin-bottom:10px}
.hero p{color:#bfe0d1;max-width:620px;font-size:clamp(14px,2.5vw,16px)}
.wrap{max-width:1100px;margin:0 auto;padding:clamp(20px,4vw,34px) clamp(16px,4vw,28px)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:11px;transition:transform .16s,box-shadow .16s}
.card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(11,58,42,.10)}
.area{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:700}
.ct{font-family:Fraunces,serif;font-size:21px;font-weight:600;line-height:1.15}
.meta{font-size:13px;color:var(--mut)}
.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:2px}
.tag{font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;background:#eef3ee;color:var(--forest)}
.tag.free{background:#e7f6ee;color:#1f7a4d}.tag.paid{background:#fbf1dc;color:#9a6b12}.tag.invite{background:#eee9f6;color:#5b3f9e}
.row{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:6px}
.state{font-size:12px;font-weight:700}.state.active{color:var(--ok)}.state.pending{color:#a6790f}
.go{background:var(--forest);color:#fff;text-decoration:none;font-size:13.5px;font-weight:600;padding:9px 18px;border-radius:10px}
.go:hover{background:var(--forest2)}
@media(max-width:520px){.nav .brand{font-size:17px}}
</style></head><body>
<div class="nav">
  <div class="brand">CRIPFCnt Academy</div>
  <div class="links">
    <a href="/courses">Courses</a>
    <a href="/modules">Modules</a>
    {{#if authed}}<a href="/me/learning">My Learning</a><a href="/me/credentials">Certificates</a><a href="/auth/logout">Sign out</a>
    {{else}}<a href="/learn/signup?next=/courses" class="cta">Sign in / Join</a>{{/if}}
  </div>
</div>
<div class="hero"><div class="in">
  <h1>Professional certification, built on real assessment.</h1>
  <p>Enrol, work through each stage, and earn a verifiable Certificate of Competence — then a Module Certificate of Mastery across a whole pillar.</p>
</div></div>
<div class="wrap">
  <div class="grid">
  {{#each courses}}
    <div class="card">
      <div class="area">{{this.area}} · {{this.level}}</div>
      <div class="ct">{{this.title}}</div>
      <div class="tags">
        {{#if (eq this.accessType "free")}}<span class="tag free">Free</span>{{else if (eq this.accessType "paid")}}<span class="tag paid">{{this.price}}</span>{{else}}<span class="tag invite">Invite only</span>{{/if}}
        <span class="tag">{{this.totalQuizzes}} assessments</span>
      </div>
      <div class="row">
        {{#if (eq this.state "active")}}<span class="state active">● Enrolled</span>
        {{else if (eq this.state "completed")}}<span class="state active">✓ Completed</span>
        {{else if (eq this.state "pending")}}<span class="state pending">Payment pending</span>
        {{else}}<span class="meta">Open for enrolment</span>{{/if}}
        <a class="go" href="/courses/{{this.slug}}">{{#if (eq this.state "browse")}}View{{else}}Continue{{/if}} →</a>
      </div>
    </div>
  {{else}}
    <p class="meta">No courses published yet — check back soon.</p>
  {{/each}}
  </div>
</div></body></html>
